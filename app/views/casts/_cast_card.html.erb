<div class="card cast-card">
  <%= link_to cast_path(cast) do %>
    <% if cast.photos.attached? %>
      <%= image_tag cast.photos.first %>
    <% else %>
      <%= image_tag "nowprinting.svg", style: "width:100%;height:160px;object-fit:cover;border-radius:6px;" %>
    <% end %>
    <h3>
      <%= cast.alias_name.presence || cast.name %> (<%= cast.age %>)
      <% if cast.is_trial? %><span class="tag-badge highlight">体験入店</span><% end %>
    </h3>
  <% end %>
  <p><%= truncate(cast.catch_copy.to_s, length: 30) %></p>
</div>
