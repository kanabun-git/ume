<% content_for :title, "#{@shop_membership.member.name}様の店舗会員証" %>

<h1><%= @shop_membership.member.name %>様の店舗会員証</h1>
<p>店舗: <%= link_to @shop.name, admin_shop_path(@shop) %></p>

<%= render "shop_memberships/card", membership: @shop_membership, card_image: @shop_membership.member.membership_card_image %>

<div class="card">
  <p>
    現在のランク: <strong><%= @shop_membership.current_rank&.name || "未認定" %></strong>
    <% if @shop_membership.next_rank %>
      (次のランク「<%= @shop_membership.next_rank.name %>」まであと<%= @shop_membership.next_rank.min_visit_count - @shop_membership.visit_count %>回)
    <% end %>
  </p>
  <p>来店回数: <%= @shop_membership.visit_count %>回 / ポイント残高: <%= @shop_membership.points %>pt</p>
  <p>
    SMS認証:
    <% if @shop_membership.member.phone_verified? %>
      <span class="tag-badge">認証済み</span>(<%= @shop_membership.member.phone_number %>)
    <% else %>
      <span class="badge muted">未認証</span>
    <% end %>
  </p>
</div>

<div class="card">
  <h2>事故歴・注意点(店舗内共有専用・会員には表示されません)</h2>
  <%= form_with model: @shop_membership, url: admin_shop_shop_membership_path(@shop, @shop_membership), method: :patch, local: true, class: "form" do |f| %>
    <label>事故歴</label>
    <%= f.text_area :incident_notes, value: @shop_membership.incident_notes %>

    <label>注意点</label>
    <%= f.text_area :caution_notes, value: @shop_membership.caution_notes %>

    <%= f.submit "保存する", class: "btn" %>
  <% end %>
</div>

<%= render "shop_memberships/visit_history",
      shop_visits: @shop_visits,
      casts: @shop.casts,
      create_path: admin_shop_shop_membership_shop_visits_path(@shop, @shop_membership),
      edit_path: ->(visit) { edit_admin_shop_shop_membership_shop_visit_path(@shop, @shop_membership, visit) } %>

<%= render "shop_memberships/point_transactions",
      transactions: @shop_point_transactions,
      redeem_path: admin_shop_shop_membership_shop_point_redemptions_path(@shop, @shop_membership),
      transactions_path: admin_shop_shop_membership_shop_point_transactions_path(@shop, @shop_membership),
      edit_transaction_path: ->(t) { edit_admin_shop_shop_membership_shop_point_transaction_path(@shop, @shop_membership, t) },
      destroy_transaction_path: ->(t) { admin_shop_shop_membership_shop_point_transaction_path(@shop, @shop_membership, t) } %>

<div class="card">
  <h2>ランクアップ特典</h2>
  <table class="admin-table">
    <thead><tr><th>特典名</th><th>種別</th><th>状態</th><th></th></tr></thead>
    <tbody>
      <% @shop_member_benefit_grants.each do |grant| %>
        <tr>
          <td><%= grant.shop_member_benefit.name %></td>
          <td><%= grant.shop_member_benefit.discount_ticket? ? "割引券" : "無料券" %></td>
          <td><%= grant.used? ? "利用済み(#{grant.used_at.strftime('%Y-%m-%d')})" : "未使用" %></td>
          <td>
            <% unless grant.used? %>
              <%= button_to "利用済みにする", mark_used_admin_shop_shop_membership_shop_member_benefit_grant_path(@shop, @shop_membership, grant), method: :patch, class: "btn secondary" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to "会員一覧に戻る", admin_shop_shop_memberships_path(@shop) %>
