<% content_for :title, "サイト情報の編集" %>

<h1>サイト情報の編集</h1>

<% if @mail_domain.errors.any? %>
  <div class="errors">
    <ul>
      <% @mail_domain.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<div class="card">
  <p>
    ドメインを変更すると、このサイトに登録済みのメールアドレスもすべて新しいドメインのものに変わります
    (<%= @mail_domain.mail_accounts.count %>件)。変更後、メールサーバーへの反映も自動で行われます。
  </p>
  <%= render "form", mail_domain: @mail_domain, url: admin_mail_domain_path(@mail_domain), submit_label: "保存する" %>
</div>

<%= link_to "メールアドレス管理に戻る", admin_mail_domains_path, class: "btn secondary" %>
