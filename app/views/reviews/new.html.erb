<% content_for :title, "口コミ投稿 | #{@shop.name}" %>

<h1><%= @shop.name %> への口コミ投稿</h1>

<% if @review.errors.any? %>
  <div class="errors">
    <ul>
      <% @review.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @review, url: shop_reviews_path(@shop), local: true, class: "form" do |f| %>
  <label>お名前(ニックネーム可)</label>
  <%= f.text_field :reviewer_name %>

  <label>対象キャスト(任意)</label>
  <%= f.collection_select :cast_id, @shop.casts.visible, :id, :name, include_blank: true %>

  <label>評価</label>
  <%= f.select :rating, (1..5).to_a.reverse %>

  <label>口コミ本文</label>
  <%= f.text_area :body %>

  <%= f.submit "投稿する", class: "btn" %>
<% end %>
