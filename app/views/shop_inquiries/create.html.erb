<% content_for :title, "お問い合わせを受け付けました | FuzokuZero" %>

<h1>お問い合わせを受け付けました</h1>

<table class="profile-table">
  <tr><th>店舗名</th><td><%= @shop_inquiry.shop_name %></td></tr>
  <tr><th>ご担当者名</th><td><%= @shop_inquiry.contact_name %></td></tr>
  <tr><th>メールアドレス</th><td><%= @shop_inquiry.email %></td></tr>
  <tr><th>電話番号</th><td><%= @shop_inquiry.phone %></td></tr>
  <tr><th>希望エリア</th><td><%= @shop_inquiry.area_note.presence || "(未記入)" %></td></tr>
  <tr><th>お問い合わせ内容</th><td><%= simple_format @shop_inquiry.message.presence || "(本文なし)" %></td></tr>
</table>

<p>担当者よりご連絡いたします。今しばらくお待ちください。</p>

<%= link_to "TOPへ戻る", root_path, class: "btn" %>
