<% content_for :title, @user.name %>
<h1><%= @user.name %></h1>
<p>メールアドレス: <%= @user.email %></p>
<p>ロール: <%= role_label(@user) %></p>
<p>所属店舗: <%= @user.shop&.name || "-" %></p>
<%= link_to "編集", edit_admin_user_path(@user), class: "btn" %>
<%= button_to "アカウント案内を発行する", issue_account_setup_link_admin_user_path(@user), method: :post, class: "btn secondary" %>
<%= button_to "アカウント案内をメールで送信する", send_account_setup_email_admin_user_path(@user), method: :post, class: "btn secondary" %>
<%= link_to "一覧に戻る", admin_users_path, class: "btn secondary" %>
