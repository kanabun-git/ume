<% content_for :title, "出勤予定一括登録" %>

<h1>出勤予定一括登録</h1>

<div class="card">
  <h2>CSV一括登録</h2>
  <p>
    <%= link_to "CSVテンプレートをダウンロード", template_shop_admin_shifts_path, class: "btn secondary" %>
  </p>
  <%= form_with url: import_shop_admin_shifts_path, method: :post, local: true, multipart: true, class: "form" do |f| %>
    <label>CSVファイル(キャスト名,勤務日,開始時刻,終了時刻,翌日にまたぐ,メモ)</label>
    <%= file_field_tag :file, accept: ".csv,text/csv" %>
    <%= submit_tag "アップロードして登録する", class: "btn" %>
  <% end %>
</div>

<%= link_to "画面で一括登録する", new_shop_admin_shift_path, class: "btn" %>

<table class="admin-table">
  <thead><tr><th>キャスト</th><th>勤務日</th><th>時間</th><th>メモ</th><th></th></tr></thead>
  <tbody>
    <% @shifts.each do |shift| %>
      <tr>
        <td><%= shift.cast.name %></td>
        <td><%= shift.work_date.strftime("%Y-%m-%d") %></td>
        <td><%= shift.formatted_time_range %></td>
        <td><%= shift.note %></td>
        <td><%= button_to "削除", shop_admin_shift_path(shift), method: :delete, form: { data: { turbo_confirm: "削除してよろしいですか?" } } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
