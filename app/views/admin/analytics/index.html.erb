<% content_for :title, "アクセス解析" %>

<h1>アクセス解析</h1>

<p>
  <%= link_to "店舗ページ", admin_analytics_path(page_type: "shop"), class: "btn #{'secondary' unless @page_type == 'shop'}" %>
  <%= link_to "女の子ページ", admin_analytics_path(page_type: "cast"), class: "btn #{'secondary' unless @page_type == 'cast'}" %>
  <%= link_to "TOP・ポータルページ", admin_analytics_path(page_type: "page"), class: "btn #{'secondary' unless @page_type == 'page'}" %>
</p>

<% if @page_type == "shop" %>
  <%= form_with url: admin_analytics_path, method: :get, local: true, class: "form" do %>
    <%= hidden_field_tag :page_type, "shop" %>
    <label>店舗で絞り込む</label>
    <%= select_tag :shop_id, options_from_collection_for_select(Shop.order(:name), :id, :name, params[:shop_id]), include_blank: "全店舗合計" %>
    <button type="submit" class="btn secondary">表示</button>
  <% end %>

  <h2>
    <%= @selected_shop ? "#{@selected_shop.name} の閲覧数推移" : "全店舗合計の閲覧数推移" %>
    (<%= @range_start.strftime("%Y-%m-%d") %> 〜 <%= @range_end.strftime("%Y-%m-%d") %>)
  </h2>
<% elsif @page_type == "cast" %>
  <%= form_with url: admin_analytics_path, method: :get, local: true, class: "form" do %>
    <%= hidden_field_tag :page_type, "cast" %>
    <label>女の子で絞り込む</label>
    <%= select_tag :cast_id, options_from_collection_for_select(Cast.order(:name), :id, :name, params[:cast_id]), include_blank: "全女の子合計" %>
    <button type="submit" class="btn secondary">表示</button>
  <% end %>

  <h2>
    <%= @selected_cast ? "#{@selected_cast.name} の閲覧数推移" : "全女の子合計の閲覧数推移" %>
    (<%= @range_start.strftime("%Y-%m-%d") %> 〜 <%= @range_end.strftime("%Y-%m-%d") %>)
  </h2>
<% else %>
  <%= form_with url: admin_analytics_path, method: :get, local: true, class: "form" do %>
    <%= hidden_field_tag :page_type, "page" %>
    <label>ページで絞り込む</label>
    <%= select_tag :page_key, options_for_select(PageDailyView::PAGE_KEYS.invert, @selected_page_key) %>
    <button type="submit" class="btn secondary">表示</button>
  <% end %>

  <h2>
    <%= PageDailyView.label_for(@selected_page_key) %> の閲覧数推移
    (<%= @range_start.strftime("%Y-%m-%d") %> 〜 <%= @range_end.strftime("%Y-%m-%d") %>)
  </h2>
<% end %>

<% max = @daily_totals.values.max || 0 %>
<div class="analytics-chart">
  <% @dates.each do |date| %>
    <% count = @daily_totals[date] || 0 %>
    <div class="analytics-bar-col" title="<%= date.strftime('%Y-%m-%d') %>: <%= count %>件">
      <div class="analytics-bar" style="height: <%= max.zero? ? 0 : (count.to_f / max * 100).round(1) %>%"></div>
    </div>
  <% end %>
</div>
<p><small>棒にカーソルを合わせると日付ごとの閲覧数が表示されます。合計: <%= @daily_totals.values.sum %>件</small></p>

<% if @page_type == "shop" %>
  <% if @selected_shop %>
    <%= link_to "全店舗合計に戻る", admin_analytics_path(page_type: "shop"), class: "btn secondary" %>
  <% else %>
    <h2>店舗別閲覧数ランキング</h2>
    <% if @top_shops.any? %>
      <table class="admin-table">
        <thead><tr><th>店舗名</th><th>閲覧数(累計)</th><th>閲覧数(直近<%= @range_days %>日)</th></tr></thead>
        <tbody>
          <% @top_shops.each do |shop, count| %>
            <tr>
              <td><%= link_to shop.name, admin_analytics_path(page_type: "shop", shop_id: shop.id) %></td>
              <td><%= shop.view_count %>件</td>
              <td><%= count %>件</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="region-note">この期間の閲覧データがまだありません。</p>
    <% end %>
  <% end %>
<% elsif @page_type == "cast" %>
  <% if @selected_cast %>
    <%= link_to "全女の子合計に戻る", admin_analytics_path(page_type: "cast"), class: "btn secondary" %>
  <% else %>
    <h2>女の子別閲覧数ランキング</h2>
    <% if @top_casts.any? %>
      <table class="admin-table">
        <thead><tr><th>名前</th><th>所属店舗</th><th>閲覧数(累計)</th><th>閲覧数(直近<%= @range_days %>日)</th></tr></thead>
        <tbody>
          <% @top_casts.each do |cast, count| %>
            <tr>
              <td><%= link_to cast.name, admin_analytics_path(page_type: "cast", cast_id: cast.id) %></td>
              <td><%= cast.shop.name %></td>
              <td><%= cast.view_count %>件</td>
              <td><%= count %>件</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="region-note">この期間の閲覧データがまだありません。</p>
    <% end %>
  <% end %>
<% else %>
  <h2>ページ別閲覧数(直近<%= @range_days %>日)</h2>
  <table class="admin-table">
    <thead><tr><th>ページ</th><th>閲覧数</th></tr></thead>
    <tbody>
      <% PageDailyView::PAGE_KEYS.each_key do |key| %>
        <tr>
          <td><%= link_to PageDailyView.label_for(key), admin_analytics_path(page_type: "page", page_key: key) %></td>
          <td><%= @page_totals[key] %>件</td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
