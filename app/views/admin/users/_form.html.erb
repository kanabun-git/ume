<% if user.errors.any? %>
  <div class="errors">
    <ul>
      <% user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: user, url: url, local: true, class: "form" do |f| %>
  <label>名前</label>
  <%= f.text_field :name %>

  <label>メールアドレス</label>
  <%= f.email_field :email %>

  <label>パスワード<%= "(変更する場合のみ入力)" unless user.new_record? %></label>
  <%= f.password_field :password %>

  <label>パスワード(確認)</label>
  <%= f.password_field :password_confirmation %>

  <label>ロール</label>
  <%= f.select :role, User.roles.keys.map { |r| [{ "cast" => "キャスト", "shop_admin" => "店舗管理者", "platform_admin" => "運営者" }[r], r] } %>

  <label>所属店舗(店舗管理者・キャストの場合)</label>
  <%= f.collection_select :shop_id, Shop.all, :id, :name, include_blank: true %>

  <%= f.submit "保存する", class: "btn" %>
<% end %>
