<% content_for :title, "地区の編集" %>

<h1>地区の編集</h1>

<% if @district.errors.any? %>
  <div class="errors">
    <ul>
      <% @district.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @district, url: admin_shop_prospect_district_path(@district), method: :patch, local: true, class: "form" do |f| %>
  <label>都道府県</label>
  <%= f.text_field :prefecture %>

  <label>地区名</label>
  <%= f.text_field :name %>

  <%= f.submit "保存する", class: "btn" %>
<% end %>
