<% content_for :title, "店舗一覧 | FuzokuZero" %>
<% content_for :meta_description, "エリア・ジャンル・料金・カップサイズから風俗店を絞り込んで探せます。" %>

<h1>店舗一覧</h1>

<form class="form" method="get">
  <label>キーワード(店舗名・キャッチコピー等)</label>
  <input type="text" name="keyword" value="<%= params[:keyword] %>" placeholder="例: 新宿、未経験大歓迎">

  <label>エリア</label>
  <select name="area_id">
    <option value="">すべて</option>
    <% Area.all.each do |area| %>
      <option value="<%= area.id %>" <%= "selected" if params[:area_id].to_s == area.id.to_s %>><%= area.name %></option>
    <% end %>
  </select>
  <label>ジャンル</label>
  <select name="genre_id">
    <option value="">すべて</option>
    <% Genre.all.each do |genre| %>
      <option value="<%= genre.id %>" <%= "selected" if params[:genre_id].to_s == genre.id.to_s %>><%= genre.name %></option>
    <% end %>
  </select>
  <label>料金</label>
  <select name="max_price">
    <option value="">指定なし</option>
    <% Shop::PRICE_FILTER_OPTIONS.each do |label, value| %>
      <option value="<%= value %>" <%= "selected" if params[:max_price].to_s == value.to_s %>><%= label %></option>
    <% end %>
  </select>
  <label>カップサイズ</label>
  <select name="cup">
    <option value="">指定なし</option>
    <% Cast::CUP_OPTIONS.each do |cup| %>
      <option value="<%= cup %>" <%= "selected" if params[:cup] == cup %>><%= cup %>カップ</option>
    <% end %>
  </select>
  <button type="submit" class="btn">絞り込む</button>
</form>

<div class="shop-listing">
  <% @shops.each do |shop| %>
    <%= render "shop_card", shop: shop %>
  <% end %>
</div>

<%= paginate @shops %>
