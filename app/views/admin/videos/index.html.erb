<% content_for :title, "体験動画管理" %>

<h1>体験動画管理</h1>
<p>運営者権限で、任意の店舗に体験動画を登録できます。動画ファイルのアップロード(容量無制限)、または動画URLのどちらでも登録可能です。</p>

<%= link_to "新規登録", new_admin_video_path, class: "btn" %>

<table class="admin-table">
  <thead><tr><th>店舗名</th><th>地域</th><th>種別</th><th>公開状態</th><th>登録日</th><th></th></tr></thead>
  <tbody>
    <% @blocks.each do |block| %>
      <tr>
        <td><%= link_to block.shop.name, shop_path(block.shop) %></td>
        <td><%= block.shop.region %></td>
        <td><%= block.video_file.attached? ? "ファイル" : "URL" %></td>
        <td><%= block.visible? ? "公開" : "非公開" %></td>
        <td><%= block.created_at.strftime("%Y/%m/%d") %></td>
        <td>
          <%= link_to "編集", edit_admin_video_path(block) %>
          <%= button_to "削除", admin_video_path(block), method: :delete, form: { data: { turbo_confirm: "削除してよろしいですか?" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @blocks %>
