<% content_for :title, @shop.name %>

<h1><%= @shop.name %></h1>
<p>状態: <%= status_label(@shop) %> / エリア: <%= @shop.area.name %> / ジャンル: <%= @shop.genre.name %> / プラン: <%= @shop.plan.name %></p>
<p>閲覧数: <%= @shop.view_count %></p>
<p><%= simple_format @shop.description.to_s %></p>

<h2>在籍キャスト</h2>
<% @shop.casts.each do |cast| %>
  <p><%= cast.name %> (<%= status_label(cast) %>)</p>
<% end %>

<h2>店舗管理者アカウント</h2>
<% shop_admin_users = @shop.users.shop_admin %>
<% if shop_admin_users.any? %>
  <table class="admin-table">
    <thead><tr><th>名前</th><th>メールアドレス</th><th></th></tr></thead>
    <tbody>
      <% shop_admin_users.each do |user| %>
        <tr>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td><%= button_to "アカウント案内を発行する", issue_account_setup_link_admin_user_path(user), method: :post, class: "btn secondary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>この店舗の店舗管理者アカウントはまだありません。</p>
  <%= link_to "アカウントを作成する", new_admin_user_path(shop_id: @shop.id, role: "shop_admin"), class: "btn" %>
<% end %>

<%= link_to "編集", edit_admin_shop_path(@shop), class: "btn" %>
<%= link_to "ページ構成(ブロック)を管理", admin_shop_shop_page_blocks_path(@shop), class: "btn secondary" %>
<%= link_to "女の子ページ構成(ブロック)を管理", admin_shop_cast_page_blocks_path(@shop), class: "btn secondary" %>
<%= link_to "返信テンプレートを管理", admin_shop_review_reply_templates_path(@shop), class: "btn secondary" %>
<%= link_to "一覧に戻る", admin_shops_path, class: "btn secondary" %>
