<% content_for :title, "#{@shop.name} - クーポン" %>

<h1><%= @shop.name %> - クーポン</h1>
<%= link_to "新規クーポン登録", new_admin_shop_coupon_path(@shop), class: "btn" %>

<table class="admin-table">
  <thead><tr><th>クーポン番号</th><th>タイトル</th><th>コース</th><th>料金</th><th>割引率</th><th>期間</th><th>利用実績</th><th></th></tr></thead>
  <tbody>
    <% @coupons.each do |coupon| %>
      <tr>
        <td><%= coupon.coupon_number %></td>
        <td><%= link_to coupon.title, admin_shop_coupon_path(@shop, coupon) %></td>
        <td><%= coupon.course_name %></td>
        <td><%= number_to_currency(coupon.regular_price, unit: "¥", precision: 0) %> → <%= number_to_currency(coupon.discounted_price, unit: "¥", precision: 0) %></td>
        <td><%= coupon.discount_percent %>%OFF</td>
        <td><%= coupon.valid_from.strftime("%Y-%m-%d") %>〜<%= coupon.unlimited? ? "無期限" : coupon.valid_until.strftime("%Y-%m-%d") %></td>
        <td><%= coupon.coupon_usages.count %>件</td>
        <td>
          <%= link_to "編集", edit_admin_shop_coupon_path(@shop, coupon) %>
          <%= button_to "削除", admin_shop_coupon_path(@shop, coupon), method: :delete, form: { data: { turbo_confirm: "削除してよろしいですか?" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "店舗詳細に戻る", admin_shop_path(@shop), class: "btn secondary" %>
