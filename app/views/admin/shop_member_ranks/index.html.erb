<% content_for :title, "#{@shop.name} - 会員ランク・特典" %>

<h1><%= @shop.name %> - 会員ランク・特典</h1>
<%= link_to "新規ランク登録", new_admin_shop_shop_member_rank_path(@shop), class: "btn" %>

<% @shop_member_ranks.each do |rank| %>
  <div class="card">
    <h2>
      <%= rank.name %>(来店<%= rank.min_visit_count %>回以上)
      <%= link_to "編集", edit_admin_shop_shop_member_rank_path(@shop, rank) %>
      <%= button_to "削除", admin_shop_shop_member_rank_path(@shop, rank), method: :delete, form: { data: { turbo_confirm: "削除してよろしいですか?" } } %>
    </h2>

    <table class="admin-table">
      <thead><tr><th>特典名</th><th>種別</th><th>内容</th><th></th></tr></thead>
      <tbody>
        <% rank.shop_member_benefits.each do |benefit| %>
          <tr>
            <td><%= benefit.name %></td>
            <td><%= benefit.discount_ticket? ? "割引券" : "無料券" %></td>
            <td><%= benefit.description %></td>
            <td>
              <%= link_to "編集", edit_admin_shop_shop_member_rank_shop_member_benefit_path(@shop, rank, benefit) %>
              <%= button_to "削除", admin_shop_shop_member_rank_shop_member_benefit_path(@shop, rank, benefit), method: :delete, form: { data: { turbo_confirm: "削除してよろしいですか?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= link_to "特典を追加", new_admin_shop_shop_member_rank_shop_member_benefit_path(@shop, rank), class: "btn secondary" %>
  </div>
<% end %>

<%= link_to "店舗詳細に戻る", admin_shop_path(@shop), class: "btn secondary" %>
