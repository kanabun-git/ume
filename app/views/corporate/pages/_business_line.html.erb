<%# locals: (line:, heading_tag: :h3) %>
<div class="corporate-card">
  <%= content_tag heading_tag, line[:title] %>
  <p><%= line[:body] %></p>
  <% if line[:features].present? %>
    <ul class="corporate-card-features">
      <% line[:features].each do |feature| %>
        <li><%= feature %></li>
      <% end %>
    </ul>
  <% end %>
  <% if line[:url].present? %>
    <p><%= link_to "#{line[:link_label] || line[:title]} →", line[:url], class: "corporate-link", target: "_blank", rel: "noopener" %></p>
  <% end %>
  <% if line[:inquiry_subject].present? %>
    <p><%= link_to "#{line[:inquiry_link_label]} →", new_corporate_inquiry_path(subject: line[:inquiry_subject]), class: "corporate-link" %></p>
  <% end %>
</div>
