<% content_for :title, "#{@shop.name} のページ構成(ブロック管理)" %>

<h1><%= @shop.name %> のページ構成(ブロック管理)</h1>
<p>店舗詳細ページに表示するブロックの追加・並び替え・表示/非表示・背景色を設定できます。</p>
<%= link_to "ブロックを追加", new_admin_shop_shop_page_block_path(@shop), class: "btn" %>

<table class="admin-table">
  <thead><tr><th>並び順</th><th>種類</th><th>タイトル</th><th>表示</th><th>背景</th><th></th></tr></thead>
  <tbody>
    <% @blocks.each do |block| %>
      <tr>
        <td>
          <%= button_to "▲", move_up_admin_shop_shop_page_block_path(@shop, block), method: :patch, form: { style: "display:inline" } %>
          <%= button_to "▼", move_down_admin_shop_shop_page_block_path(@shop, block), method: :patch, form: { style: "display:inline" } %>
        </td>
        <td><%= ShopPageBlock::LABELS.fetch(block.block_type, block.block_type) %></td>
        <td><%= block.title %></td>
        <td>
          <%= button_to (block.visible? ? "表示中" : "非表示中"), toggle_visibility_admin_shop_shop_page_block_path(@shop, block), method: :patch, class: (block.visible? ? "btn" : "btn secondary"), form: { style: "display:inline" } %>
        </td>
        <td>
          <% if block.background_color.present? %>
            <span style="display:inline-block;width:20px;height:20px;border-radius:4px;vertical-align:middle;<%= block.background_style %>"></span>
            <%= block.background_color %> (<%= block.background_opacity %>)
          <% else %>
            <small>デフォルト</small>
          <% end %>
        </td>
        <td>
          <%= link_to "編集", edit_admin_shop_shop_page_block_path(@shop, block) %>
          <%= button_to "削除", admin_shop_shop_page_block_path(@shop, block), method: :delete, form: { data: { turbo_confirm: "削除してよろしいですか?" }, style: "display:inline" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "店舗ページのプレビューを見る", shop_path(@shop), class: "btn secondary", target: "_blank" %>
<%= link_to "店舗詳細に戻る", admin_shop_path(@shop), class: "btn secondary" %>
