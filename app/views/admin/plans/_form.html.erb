<% if plan.errors.any? %>
  <div class="errors">
    <ul>
      <% plan.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: plan, url: url, local: true, class: "form" do |f| %>
  <label>名前</label>
  <%= f.text_field :name %>

  <label>月額料金(円)</label>
  <%= f.number_field :monthly_fee %>

  <label>優先度(ランキング倍率)</label>
  <%= f.number_field :priority_weight %>

  <label>並び順</label>
  <%= f.number_field :position %>

  <%= f.submit "保存する", class: "btn" %>
<% end %>
