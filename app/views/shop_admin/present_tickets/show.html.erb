<% content_for :title, @present_ticket.name %>

<h1><%= @present_ticket.name %></h1>
<p><span class="badge"><%= status_label(@present_ticket) %></span></p>
<p><%= simple_format @present_ticket.description.to_s %></p>
<p>当選人数: <%= @present_ticket.capacity %>名 / 応募締切: <%= @present_ticket.deadline_at.strftime("%Y-%m-%d %H:%M") %></p>

<div class="card">
  <% if @present_ticket.accepting? %>
    <%= button_to "抽選する(応募者#{@entries.count}名から#{@present_ticket.capacity}名を抽選)", draw_shop_admin_present_ticket_path(@present_ticket), method: :post, class: "btn", form: { data: { turbo_confirm: "抽選を実行します。よろしいですか?(この操作は取り消せません)" } } %>
  <% else %>
    <%= button_to "当落メールを送信する(未送信#{@entries.where(notified_at: nil).where.not(status: :pending).count}件)", send_result_emails_shop_admin_present_ticket_path(@present_ticket), method: :post, class: "btn" %>
  <% end %>
</div>

<table class="admin-table">
  <thead><tr><th>会員</th><th>応募日時</th><th>結果</th><th>メール送信</th></tr></thead>
  <tbody>
    <% @entries.each do |entry| %>
      <tr>
        <td><%= entry.member.name %></td>
        <td><%= entry.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= status_label(entry) %></td>
        <td><%= entry.notified? ? entry.notified_at.strftime("%Y-%m-%d %H:%M") : "未送信" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "一覧に戻る", shop_admin_present_tickets_path, class: "btn secondary" %>
