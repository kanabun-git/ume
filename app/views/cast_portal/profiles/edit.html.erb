<% content_for :title, "プロフィール編集 | キャストマイページ" %>

<h1>プロフィール編集</h1>

<% if @cast.errors.any? %>
  <div class="errors">
    <ul>
      <% @cast.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @cast, url: cast_profile_path, method: :patch, local: true, class: "form" do |f| %>
  <p>氏名・年齢・在籍店舗は店舗管理者のみ変更できます。</p>

  <label>キャッチコピー</label>
  <%= f.text_field :catch_copy %>

  <label>自己紹介</label>
  <%= f.text_area :description %>

  <label>身長(cm)</label>
  <%= f.number_field :height %>

  <label>バスト</label>
  <%= f.number_field :bust %>

  <label>カップ</label>
  <%= f.text_field :cup %>

  <label>ウエスト</label>
  <%= f.number_field :waist %>

  <label>ヒップ</label>
  <%= f.number_field :hip %>

  <label>星座</label>
  <%= f.text_field :zodiac_sign %>

  <label>血液型</label>
  <%= f.text_field :blood_type %>

  <label>アピールコメント</label>
  <%= f.text_area :appeal_comment %>

  <label>セールスポイント</label>
  <%= f.text_area :selling_points %>

  <label>女の子に質問(自由記載のQ&amp;A)</label>
  <%= f.text_area :qa_message %>

  <label>写真を追加</label>
  <%= f.file_field :photos, multiple: true %>

  <% if @cast.photos.attached? %>
    <div class="grid">
      <% @cast.photos.each do |photo| %>
        <div class="photo-with-status">
          <%= image_tag photo, style: "max-width:120px;" %>
          <% if photo.hidden? %>
            <span class="badge muted">運営により非公開</span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= f.submit "更新する", class: "btn" %>
<% end %>
