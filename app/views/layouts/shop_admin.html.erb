<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "店舗管理画面 | FuzokuZero" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body>
    <div class="admin-shell">
      <div class="sidebar">
        <div class="brand">店舗管理画面</div>
        <%= link_to "ダッシュボード", shop_admin_root_path %>
        <%= link_to "店舗情報編集", edit_shop_admin_shop_path %>
        <%= link_to "ページ構成(ブロック)", shop_admin_shop_page_blocks_path %>
        <%= link_to "在籍キャスト", shop_admin_casts_path %>
        <%= link_to "出勤予定一括登録", shop_admin_shifts_path %>
        <%= link_to "プレゼント企画管理", shop_admin_present_tickets_path %>
        <%= link_to "クーポン管理", shop_admin_coupons_path %>
        <%= link_to "店舗会員証管理", shop_admin_shop_memberships_path %>
        <%= link_to "会員ランク・特典設定", shop_admin_shop_member_ranks_path %>
        <%= link_to "女の子ページ構成(ブロック)", shop_admin_cast_page_blocks_path %>
        <%= link_to "日記一覧", shop_admin_diary_entries_path %>
        <%= link_to "口コミ", shop_admin_reviews_path %>
        <%= link_to "サイトを見る", root_path %>
        <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "link-button" %>
      </div>
      <div class="content">
        <% if current_shop.published? %>
          <div class="notice">
            公開中です。公開ページに表示されています。
            <%= button_to "非公開にする(下書きに戻す)", unpublish_shop_admin_shop_path, method: :patch, class: "link-button",
                form: { data: { turbo_confirm: "非公開にすると、公開ページから一時的に見えなくなります。よろしいですか?" } } %>
          </div>
        <% else %>
          <div class="alert">
            非公開(下書き)です。公開ページには表示されません。デザインやキャスト情報の準備ができたら公開してください。
            <%= button_to "公開する", publish_shop_admin_shop_path, method: :patch, class: "link-button" %>
          </div>
        <% end %>
        <% if notice %><div class="notice"><%= notice %></div><% end %>
        <% if alert %><div class="alert"><%= alert %></div><% end %>
        <%= yield %>
      </div>
    </div>
    <%= render "layouts/turbo_confirm_shim" %>
  </body>
</html>
