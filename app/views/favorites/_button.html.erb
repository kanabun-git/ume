<% if member_signed_in? %>
  <% if current_member.favorited?(cast) %>
    <%= button_to "♥ お気に入り解除", favorite_path(cast), method: :delete, class: "btn secondary favorite-btn favorited" %>
  <% else %>
    <%= button_to "♡ お気に入りに追加", favorites_path, method: :post, params: { cast_id: cast.id }, class: "btn secondary favorite-btn" %>
  <% end %>
<% else %>
  <%= link_to "♡ お気に入りに追加(要会員登録)", new_member_session_path, class: "btn secondary favorite-btn" %>
<% end %>
