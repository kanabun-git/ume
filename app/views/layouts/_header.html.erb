<header class="site-header">
  <div class="container site-header-utility">
    <%= link_to "掲載のお問い合わせ", new_shop_inquiry_path %>
    <div class="site-header-utility-right">
      <% if member_signed_in? %>
        <%= link_to "会員マイページ", member_root_path %>
        <%= button_to "会員ログアウト", destroy_member_session_path, method: :delete, class: "link-button" %>
      <% else %>
        <%= link_to "会員登録", new_member_registration_path %>
        <%= link_to "会員ログイン", new_member_session_path %>
      <% end %>
      <% if user_signed_in? %>
        <%= link_to "マイページ", current_user.platform_admin? ? admin_root_path : (current_user.shop_admin? ? shop_admin_root_path : cast_root_path) %>
        <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "link-button" %>
      <% else %>
        <%= link_to "関係者ログイン", new_user_session_path %>
      <% end %>
    </div>
  </div>

  <div class="container site-header-main">
    <%= link_to root_path, class: "logo" do %>
      <% if (logo = site_logo(:horizontal)) %>
        <%= image_tag logo, alt: "FuzokuZero", class: "site-logo-img" %>
      <% else %>
        <%= image_tag "site_logo_horizontal.svg", alt: "FuzokuZero", class: "site-logo-img" %>
      <% end %>
    <% end %>

    <%= form_with url: shops_path, method: :get, local: true, class: "site-header-search" do |f| %>
      <%= f.text_field :keyword, placeholder: "店舗名・エリアなどで検索", class: "site-header-search-input" %>
      <button type="submit" class="site-header-search-btn" aria-label="検索">🔍</button>
    <% end %>

    <nav class="site-header-nav">
      <%= link_to "エリアから探す", root_path %>
      <%= link_to "店舗一覧", shops_path %>
      <%= link_to "女の子検索", casts_path %>
      <%= link_to "ランキング", rankings_path %>
    </nav>
  </div>

  <div class="site-header-prefectures">
    <div class="container site-header-prefectures-inner">
      <%= link_to "全国", root_path, class: "prefecture-tab" %>
      <% nav_regions.each do |region| %>
        <% region[:prefectures].each do |prefecture| %>
          <%= link_to prefecture.name, area_path(prefecture), class: "prefecture-tab" %>
        <% end %>
      <% end %>
      <%= link_to "他の都道府県を選ぶ", root_path, class: "prefecture-tab prefecture-tab-more" %>
    </div>
  </div>
</header>
