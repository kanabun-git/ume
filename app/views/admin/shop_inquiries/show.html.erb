<% content_for :title, "#{@shop_inquiry.shop_name} からのお問い合わせ" %>

<h1><%= @shop_inquiry.shop_name %> からのお問い合わせ</h1>
<p><span class="badge <%= "muted" if @shop_inquiry.closed? %>"><%= status_label(@shop_inquiry) %></span></p>

<table class="profile-table">
  <tr><th>店舗名</th><td><%= @shop_inquiry.shop_name %></td></tr>
  <tr><th>ご担当者名</th><td><%= @shop_inquiry.contact_name %></td></tr>
  <tr><th>メールアドレス</th><td><%= mail_to @shop_inquiry.email %></td></tr>
  <tr><th>電話番号</th><td><%= @shop_inquiry.phone %></td></tr>
  <tr><th>希望エリア</th><td><%= @shop_inquiry.area_note.presence || "(未記入)" %></td></tr>
  <tr><th>受付日時</th><td><%= @shop_inquiry.created_at.strftime("%Y-%m-%d %H:%M") %></td></tr>
</table>

<h2>お問い合わせ内容</h2>
<p><%= simple_format @shop_inquiry.message.presence || "(本文なし)" %></p>

<h2>返信</h2>
<% if @shop_inquiry.replied_at %>
  <p>
    <span class="badge muted">返信済み(<%= @shop_inquiry.replied_at.strftime("%Y-%m-%d %H:%M") %>)</span>
  </p>
  <p><%= simple_format @shop_inquiry.reply_body %></p>
  <p><small>内容を修正して再送する場合は、以下にあらためて入力して送信してください(前回の返信内容は上書きされます)。</small></p>
<% else %>
  <p><span class="badge warning">未返信</span></p>
<% end %>
<%= form_with url: reply_admin_shop_inquiry_path(@shop_inquiry), method: :patch, local: true, class: "form" do %>
  <label>
    返信内容(<%= @shop_inquiry.email %> 宛にメールで送信されます)
    <% unless @shop_inquiry.replied_at %>
      — <%= link_to "定型文を編集する", edit_admin_shop_inquiry_reply_template_path %>
    <% end %>
  </label>
  <%= text_area_tag :reply_body, @reply_body, rows: 6 %>
  <%= submit_tag "返信メールを送信する", class: "btn" %>
<% end %>

<h2>対応状況</h2>
<p>
  <% ShopInquiry.statuses.each_key do |status| %>
    <% next if status == @shop_inquiry.status %>
    <%= button_to "「#{ApplicationHelper::STATUS_LABELS["ShopInquiry"][status]}」にする", update_status_admin_shop_inquiry_path(@shop_inquiry, status: status), method: :patch, class: "btn secondary" %>
  <% end %>
</p>

<h2>担当者へ連絡後</h2>
<p>
  電話・メールでの確認が済んだら、以下から新規店舗登録を行ってください(店舗名のみ引き継がれます)。
  <%= link_to "この内容で店舗を登録する", new_admin_shop_path(shop_name: @shop_inquiry.shop_name), class: "btn" %>
</p>

<% if @shop_inquiry.archived? %>
  <%= button_to "一覧に戻す", unarchive_admin_shop_inquiry_path(@shop_inquiry), method: :patch, class: "btn secondary" %>
  <%= button_to "完全に削除する", admin_shop_inquiry_path(@shop_inquiry), method: :delete,
      form: { data: { turbo_confirm: "このお問い合わせを完全に削除します。この操作は元に戻せません。よろしいですか?" } },
      class: "btn danger" %>
<% else %>
  <%= button_to "アーカイブする", archive_admin_shop_inquiry_path(@shop_inquiry), method: :patch,
      form: { data: { turbo_confirm: "このお問い合わせをアーカイブしますか?一覧から見えなくなりますが、削除はされずアーカイブ済み一覧から確認できます。" } },
      class: "btn secondary" %>
<% end %>

<%= link_to "一覧に戻る", admin_shop_inquiries_path, class: "btn secondary" %>
