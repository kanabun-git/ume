<div class="auth-page">
  <div class="auth-card">
    <h2 class="auth-title"><%= t(".change_your_password") %></h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="form-field">
        <%= f.label :password, t(".new_password") %>
        <% if @minimum_password_length %>
          <p class="hint"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password" %>
      </div>

      <div class="form-field">
        <%= f.label :password_confirmation, t(".confirm_new_password") %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <%= f.submit t(".change_my_password"), class: "btn auth-submit" %>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
