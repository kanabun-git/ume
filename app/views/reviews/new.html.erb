<% content_for :title, "口コミ投稿 | #{@shop.name}" %>

<h1><%= @shop.name %> への口コミ投稿</h1>

<% if @review.errors.any? %>
  <div class="errors">
    <ul>
      <% @review.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @review, url: shop_reviews_path(@shop), local: true, class: "form" do |f| %>
  <%# Honeypot: real visitors never see this (off-screen, not display:none,
      since some bots skip hidden/display:none fields specifically). Any
      value here means a bot filled every field it found. %>
  <div class="honeypot-field" aria-hidden="true">
    <label for="review_website">ウェブサイト</label>
    <input type="text" name="review[website]" id="review_website" tabindex="-1" autocomplete="off">
  </div>

  <label>お名前(ニックネーム可)</label>
  <%= f.text_field :reviewer_name %>

  <label>対象キャスト(任意)</label>
  <%= f.collection_select :cast_id, @shop.casts.visible, :id, :name, include_blank: true %>

  <label>評価</label>
  <%= f.select :rating, (1..5).to_a.reverse %>

  <label>口コミ本文</label>
  <%= f.text_area :body %>

  <%= f.submit "投稿する", class: "btn" %>
<% end %>
