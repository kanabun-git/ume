<!DOCTYPE html>
<html>
  <head>
    <% page_title = content_for(:title) || "FuzokuZero" %>
    <% page_description = content_for(:meta_description) || "FuzokuZeroは、全国の風俗店・在籍キャストをエリア・ジャンルから探せるポータルサイトです。" %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= page_description %>">
    <meta property="og:site_name" content="FuzokuZero">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <% og_image_url = content_for(:og_image) || (site_logo(:square_large) ? rails_blob_url(site_logo(:square_large), host: request.base_url) : image_url("site_logo_square.jpg")) %>
    <meta property="og:image" content="<%= og_image_url %>">
    <meta name="twitter:card" content="summary_large_image">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <% if (favicon = site_logo(:square_small)) %>
      <link rel="icon" href="<%= rails_blob_path(favicon) %>">
      <link rel="apple-touch-icon" href="<%= rails_blob_path(favicon) %>">
    <% else %>
      <link rel="icon" href="/icon.png" type="image/png">
      <link rel="icon" href="/icon.svg" type="image/svg+xml">
      <link rel="apple-touch-icon" href="/icon.png">
    <% end %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <%= link_to root_path, class: "logo" do %>
          <% if (logo = site_logo(:horizontal)) %>
            <%= image_tag logo, alt: "FuzokuZero", class: "site-logo-img" %>
          <% else %>
            <%= image_tag "site_logo_horizontal.svg", alt: "FuzokuZero", class: "site-logo-img" %>
          <% end %>
        <% end %>
        <nav>
          <%= link_to "エリアから探す", root_path %>
          <%= link_to "店舗一覧", shops_path %>
          <%= link_to "女の子検索", casts_path %>
          <%= link_to "ランキング", rankings_path %>
          <%= link_to "掲載のお問い合わせ", new_shop_inquiry_path %>
          <% if user_signed_in? %>
            <%= link_to "マイページ", current_user.platform_admin? ? admin_root_path : (current_user.shop_admin? ? shop_admin_root_path : cast_root_path) %>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "link-button" %>
          <% else %>
            <%= link_to "関係者ログイン", new_user_session_path %>
          <% end %>
        </nav>
      </div>
    </header>

    <div class="flash">
      <% if notice %><div class="notice"><%= notice %></div><% end %>
      <% if alert %><div class="alert"><%= alert %></div><% end %>
    </div>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
