<%
  areas_by_name = (@prefectures_by_region[region] || []).index_by(&:name)
  grid = region_map_grid(region)
  max_row = grid.values.map(&:first).max || 1
  max_col = grid.values.map(&:last).max || 1
%>
<div class="region-map-block">
  <h3 class="region-name"><%= region %></h3>
  <div class="region-map" style="grid-template-columns: repeat(<%= max_col %>, 1fr); grid-template-rows: repeat(<%= max_row %>, 1fr);">
    <% grid.each do |pref_name, (row, col)| %>
      <% area = areas_by_name[pref_name] %>
      <div class="region-map-cell" style="grid-row: <%= row %>; grid-column: <%= col %>;">
        <% if area %>
          <%= link_to area.name, area_path(area), class: "region-map-pref active" %>
        <% else %>
          <span class="region-map-pref inactive" title="準備中"><%= pref_name %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
