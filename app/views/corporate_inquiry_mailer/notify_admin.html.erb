<p>コーポレートサイトからお問い合わせが届きました。</p>

<table>
  <tr><th>件名</th><td><%= @inquiry.subject %></td></tr>
  <tr><th>お名前</th><td><%= @inquiry.name %></td></tr>
  <tr><th>会社名</th><td><%= @inquiry.company_name.presence || "(未記入)" %></td></tr>
  <tr><th>メールアドレス</th><td><%= @inquiry.email %></td></tr>
  <tr><th>電話番号</th><td><%= @inquiry.phone.presence || "(未記入)" %></td></tr>
</table>

<p>お問い合わせ内容</p>
<p><%= simple_format @inquiry.message %></p>
