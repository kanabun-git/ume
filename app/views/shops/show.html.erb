<% content_for :title, "#{@shop.name} | FuzokuZero" %>
<% content_for :meta_description, "#{@shop.name}(#{@shop.area.name}・#{@shop.genre.name})#{"。" if @shop.catch_copy.present?}#{@shop.catch_copy}"[0, 120] %>
<% if @shop.photos.attached? %>
  <% content_for :og_image, rails_blob_url(@shop.photos.first, host: request.base_url) %>
<% end %>

<div class="shop-theme-page" style="<%= shop_page_theme_style(@shop) %>">

<% if member_signed_in? && (membership = current_member.shop_memberships.find_by(shop: @shop)) %>
  <div class="shop-member-rank-badge">
    <span class="shop-member-rank-badge-label">この店舗の会員ランク</span>
    <span class="shop-member-rank-badge-rank"><%= membership.current_rank&.name || "未認定" %></span>
    <%= link_to "詳細を見る", member_shop_membership_path(membership), class: "shop-member-rank-badge-link" %>
  </div>
<% end %>

<h1>
  <%= @shop.name %><% if @shop.chain_name.present? %><span class="shop-listing-chain">(<%= @shop.chain_name %>)</span><% end %>
  <% if @shop.zero_recommended_badge? %><span class="tag-badge zero-recommend">Zeroお勧め</span><% end %>
  <% if @shop.pr_badge_active? %><span class="tag-badge pr-badge">PR</span><% end %>
</h1>
<p><span class="badge"><%= @shop.genre.name %></span> <span class="badge muted"><%= @shop.area.name %></span></p>
<p><%= @shop.catch_copy %></p>
<%= render "shop_favorites/button", shop: @shop %>
<%= render "shop_memberships/button", shop: @shop %>

<% if @shop.online_reservation? || @shop.visit_point_program? || @shop.coupon_available? || @shop.event_ongoing? %>
  <div class="shop-badge-row">
    <% if @shop.online_reservation? %><span class="tag-badge">ネット予約</span><% end %>
    <% if @shop.visit_point_program? %><span class="tag-badge">来店ポイント</span><% end %>
    <% if @shop.coupon_available? %><span class="tag-badge">クーポン</span><% end %>
    <% if @shop.event_ongoing? %><span class="tag-badge highlight">イベント開催中</span><% end %>
  </div>
<% end %>

<% if @shop.editor_review.present? %>
  <div class="card editor-review-card">
    <h2>編集部のレビュー</h2>
    <p><%= simple_format @shop.editor_review %></p>
  </div>
<% end %>

<%# Blocks below are freely composed/ordered/hidden by the shop admin from
    /shop_admin/shop_page_blocks — see ShopPageBlock. %>
<% @shop.shop_page_blocks.visible.each do |block| %>
  <% next if block.block_type == "recruiting" && !(@shop.recruiting_cast? || @shop.recruiting_staff?) %>
  <div class="obi-block<%= " no-header" if block.hide_header? %>">
    <% unless block.hide_header? %>
      <div class="obi-header"><%= block.label %></div>
    <% end %>
    <div class="obi-body<%= " no-header" if block.hide_header? %>" style="<%= block.background_style %>">
      <%= render "shops/blocks/#{block.block_type}", shop: @shop, block: block %>
    </div>
  </div>
<% end %>

<div class="obi-block">
  <div class="obi-header">在籍キャスト</div>
  <div class="obi-body">
    <div class="cast-grid">
      <% @casts.each do |cast| %>
        <%= render "casts/cast_card", cast: cast %>
      <% end %>
    </div>
  </div>
</div>

<%= render "present_tickets", shop: @shop %>

<% if @coupons.any? %>
  <div class="obi-block">
    <div class="obi-header" id="coupons">クーポン</div>
    <div class="obi-body">
      <div class="coupon-detail-actions">
        <button type="button" class="btn coupon-print-btn" onclick="window.print()">🖨️ このページを印刷する</button>
        <%= mail_to "", "✉️ このページのURLを送る", subject: "#{@shop.name}のクーポン", body: request.original_url, class: "btn secondary" %>
      </div>
      <p class="coupon-detail-warning">※各クーポンの利用条件を必ずご確認ください。</p>

      <% @coupons.each do |coupon| %>
        <%= render "coupons/coupon_detail", coupon: coupon, cheapest: @cheapest_coupon_ids.include?(coupon.id), show_shop: true %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="obi-block">
  <div class="obi-header" id="reviews">口コミ</div>
  <div class="obi-body">
    <%= link_to "口コミを投稿する", new_shop_review_path(@shop), class: "btn" %>
    <% @reviews.each do |review| %>
      <div class="shop-review-item">
        <p class="stars">評価: <%= review.rating %> / 5</p>
        <% if review.body.to_s.length > 100 %>
          <details class="review-body">
            <summary><%= truncate(review.body, length: 100) %></summary>
            <p><%= review.body %></p>
          </details>
        <% else %>
          <p><%= review.body %></p>
        <% end %>
        <p><small>
          <%= review.reviewer_name %>
          <% if review.member&.rank %><span class="tag-badge"><%= review.member.rank.name %></span><% end %>
          - <%= review.created_at.strftime("%Y-%m-%d") %>
        </small></p>
        <% if review.shop_reply.present? %>
          <div class="shop-reply">
            <p class="shop-reply-label">店舗からの返信</p>
            <p><%= review.shop_reply %></p>
          </div>
        <% end %>
        <%= button_to "👍 役に立った (#{review.review_helpful_votes.count})", helpful_shop_review_path(@shop, review), method: :post, class: "btn secondary" %>
      </div>
    <% end %>
  </div>
</div>

</div>
