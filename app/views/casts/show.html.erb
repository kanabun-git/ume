<% content_for :title, "#{@cast.name} | #{@shop.name} | FuzokuZero" %>

<h1>
  <%= @cast.alias_name.presence || @cast.name %>
  <% if @cast.is_trial? %><span class="tag-badge highlight">体験入店</span><% end %>
  <% if @cast.manager_recommended? %><span class="tag-badge">店長おすすめ</span><% end %>
</h1>
<p><%= link_to @shop.name, shop_path(@shop) %></p>

<%# Blocks below are shared across every cast at this shop, freely
    composed/ordered/hidden/styled by the shop admin from
    /shop_admin/cast_page_blocks — see CastPageBlock. %>
<div class="girl-detail-layout">
  <div class="girl-detail-main">
    <% @shop.cast_page_blocks.visible.layout_column_main.each do |block| %>
      <% next if block.block_type == "qa" && @cast.qa_message.blank? %>
      <% next if block.block_type == "appeal_comment" && @cast.appeal_comment.blank? %>
      <% next if block.block_type == "selling_points" && @cast.selling_points.blank? %>
      <% next if block.block_type == "manager_comment" && @cast.manager_comment.blank? %>
      <% next if block.block_type == "free_text" && block.settings["body"].blank? %>
      <div class="obi-block">
        <div class="obi-header"><%= block.label %></div>
        <div class="obi-body" style="<%= block.background_style %>">
          <%= render "casts/blocks/#{block.block_type}", cast: @cast, block: block %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="girl-detail-side">
    <% @shop.cast_page_blocks.visible.layout_column_side.each do |block| %>
      <div class="obi-block">
        <div class="obi-header"><%= block.label %></div>
        <div class="obi-body" style="<%= block.background_style %>">
          <%= render "casts/blocks/#{block.block_type}", cast: @cast, block: block %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% @diary_entries.each do |entry| %>
  <div class="card" id="diary-<%= entry.id %>">
    <h3><%= entry.title %></h3>
    <p><small><%= entry.published_at&.strftime("%Y-%m-%d %H:%M") %></small></p>
    <% entry.images.each do |img| %>
      <%= image_tag img, style: "max-width:200px;" %>
    <% end %>
    <p><%= simple_format entry.body %></p>
  </div>
<% end %>
