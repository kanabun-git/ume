<% if shop.errors.any? %>
  <div class="errors">
    <ul>
      <% shop.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: shop, url: url, local: true, class: "form" do |f| %>
  <label>店舗名</label>
  <%= f.text_field :name %>

  <label>系列名(例: FG系列。任意)</label>
  <%= f.text_field :chain_name %>

  <label>エリア</label>
  <%= f.collection_select :area_id, Area.all, :id, :name %>

  <label>ジャンル</label>
  <%= f.collection_select :genre_id, Genre.all, :id, :name %>

  <label>プラン</label>
  <%= f.collection_select :plan_id, Plan.all, :id, :name %>

  <label>キャッチコピー</label>
  <%= f.text_field :catch_copy %>

  <label>店舗紹介</label>
  <%= f.text_area :description %>

  <label>住所</label>
  <%= f.text_field :address %>

  <label>電話番号</label>
  <%= f.text_field :phone %>

  <label>営業時間</label>
  <%= f.text_field :business_hours %>

  <label>料金</label>
  <%= f.text_field :price_note %>

  <label>最低料金(円。店舗検索の料金絞り込みに使われます)</label>
  <%= f.number_field :min_price %>

  <label>交通費</label>
  <%= f.text_field :transportation_fee_note %>

  <label>対応エリア</label>
  <%= f.text_field :coverage_area_note %>

  <label>編集部レビュー(運営者のみ編集可)</label>
  <%= f.text_area :editor_review %>

  <label>掲載バッジ</label>
  <label><%= f.check_box :online_reservation %> ネット予約</label>
  <label><%= f.check_box :visit_point_program %> 来店ポイント</label>
  <label><%= f.check_box :coupon_available %> クーポン</label>
  <label><%= f.check_box :event_ongoing %> イベント開催中</label>
  <label><%= f.check_box :recruiting_cast %> コンパニオン募集</label>
  <label><%= f.check_box :recruiting_staff %> スタッフ募集</label>

  <label>店舗写真</label>
  <%= f.file_field :photos, multiple: true %>

  <%= f.submit "保存する", class: "btn" %>
<% end %>
