<% content_for :title, "プラン管理" %>

<h1>プラン管理</h1>

<div class="card">
  <h2>CSV一括登録</h2>
  <p>
    <%= link_to "CSVテンプレートをダウンロード", template_admin_plans_path, class: "btn secondary" %>
  </p>
  <%= form_with url: import_admin_plans_path, method: :post, local: true, multipart: true, class: "form" do %>
    <label>CSVファイル(名前,月額料金,表示優先度,表示順)</label>
    <%= file_field_tag :file, accept: ".csv,text/csv" %>
    <%= submit_tag "アップロードして登録する", class: "btn" %>
  <% end %>
  <p>
    <%= link_to "登録済みのプランをCSVダウンロード", export_admin_plans_path, class: "btn secondary" %>
  </p>
</div>

<%= link_to "新規プラン登録", new_admin_plan_path, class: "btn" %>

<table class="admin-table">
  <thead><tr><th>名前</th><th>月額料金</th><th>優先度</th><th></th></tr></thead>
  <tbody>
    <% @plans.each do |plan| %>
      <tr>
        <td><%= plan.name %></td>
        <td><%= number_to_currency(plan.monthly_fee, unit: "¥", precision: 0) %></td>
        <td><%= plan.priority_weight %></td>
        <td>
          <%= link_to "編集", edit_admin_plan_path(plan) %>
          <%= button_to "削除", admin_plan_path(plan), method: :delete, form: { data: { turbo_confirm: "削除してよろしいですか?" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
