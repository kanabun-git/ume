<% content_for :title, "サイト設定" %>

<h1>サイト設定</h1>
<p>サイトの基本画像(Now Printing・ロゴ・会員証イメージなど)は<%= link_to "サイト基本設定", edit_admin_basic_setting_path %>にまとめてあります。</p>

<div class="card">
  <h2>メンテナンスモード</h2>
  <p>
    オンにすると、一般公開ページ(TOP・店舗一覧・店舗詳細・キャスト詳細など)は
    メンテナンス中の案内画面に切り替わります。運営管理画面・店舗管理画面・
    キャストマイページ・ログイン画面は、メンテナンス中でもこれまで通り利用できます。
  </p>

  <%= form_with model: @site_setting, url: admin_setting_path, method: :patch, local: true, multipart: true, class: "form" do |f| %>
    <label>
      <%= f.check_box :maintenance_mode %>
      メンテナンスモードを有効にする
    </label>

    <label>案内メッセージ(空欄の場合は標準メッセージを表示。メンテナンス画像を設定した場合はメッセージより画像が優先されます)</label>
    <%= f.text_area :maintenance_message, placeholder: "例: 8/10 22:00〜24:00の間、サーバーメンテナンスのためサイトをご利用いただけません。" %>

    <label>メンテナンス画像(任意。設定すると上記のメッセージの代わりに表示されます)</label>
    <% if @site_setting.maintenance_image.attached? %>
      <div class="image-setting-preview">
        <%= image_tag @site_setting.maintenance_image %>
      </div>
    <% end %>
    <%= f.file_field :maintenance_image, accept: "image/jpeg,image/png,image/webp" %>

    <label>サイト掲載のお問い合わせバナー(任意。クリックすると「サイト掲載のお問い合わせ」ページに移動します。未設定の場合は画像の下にテキストリンクを表示します)</label>
    <% if @site_setting.maintenance_banner_image.attached? %>
      <div class="image-setting-preview">
        <%= image_tag @site_setting.maintenance_banner_image %>
      </div>
    <% end %>
    <%= f.file_field :maintenance_banner_image, accept: "image/jpeg,image/png,image/webp" %>

    <%= f.submit "保存する", class: "btn" %>
  <% end %>
</div>
