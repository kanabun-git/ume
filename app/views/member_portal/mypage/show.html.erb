<% content_for :title, "お気に入り一覧 | 会員マイページ" %>

<div class="card">
  <h2>会員ランク</h2>
  <% if current_member.rank %>
    <p><span class="tag-badge"><%= current_member.rank.name %></span> (承認済み口コミ<%= current_member.approved_review_count %>件)</p>
  <% else %>
    <p>まだランクがありません。(承認済み口コミ<%= current_member.approved_review_count %>件)</p>
  <% end %>
  <% if current_member.next_rank %>
    <p><small>次のランク「<%= current_member.next_rank.name %>」まであと<%= current_member.next_rank.min_approved_count - current_member.approved_review_count %>件</small></p>
  <% end %>
</div>

<h1>お気に入りの店舗</h1>

<% if @favorite_shops.any? %>
  <div class="grid">
    <% @favorite_shops.each do |shop| %>
      <div class="card favorite-card">
        <%= link_to shop_path(shop) do %>
          <% if shop.photos.attached? %>
            <%= image_tag shop.photos.first %>
          <% else %>
            <%= nowprinting_image_tag %>
          <% end %>
        <% end %>
        <h3><%= link_to shop.name, shop_path(shop) %></h3>
        <p class="diary-meta"><span class="badge"><%= shop.genre.name %></span> <span class="badge muted"><%= shop.area.name %></span></p>
        <%= button_to "お気に入り解除", shop_favorite_path(shop), method: :delete, class: "btn secondary" %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="region-note">まだお気に入りの店舗がありません。気になる店舗のページから「お気に入り店舗に追加」してみましょう。</p>
<% end %>

<h1>お気に入りの女の子</h1>

<% if @favorite_casts.any? %>
  <div class="grid">
    <% @favorite_casts.each do |cast| %>
      <div class="card favorite-card">
        <%= link_to cast_path(cast) do %>
          <%= photo_or_placeholder_tag cast.visible_photos.first, removed: cast.photos_removed_by_moderation? %>
        <% end %>
        <h3><%= link_to cast.alias_name.presence || cast.name, cast_path(cast) %></h3>
        <p class="diary-meta"><%= link_to cast.shop.name, shop_path(cast.shop) %></p>

        <% shift = @today_shifts_by_cast_id[cast.id] %>
        <% if shift %>
          <p class="favorite-shift-status on-duty">本日出勤: <%= shift.formatted_start_time %>〜<%= shift.formatted_end_time(cast.shop.time_display_format) %></p>
        <% else %>
          <p class="favorite-shift-status off-duty">本日の出勤予定なし</p>
        <% end %>

        <% entry = @latest_diary_entry_by_cast_id[cast.id] %>
        <% if entry %>
          <p class="favorite-diary-update">
            最新日記: <%= link_to entry.title, cast_path(cast, anchor: "diary-#{entry.id}") %>
            <br><small><%= entry.published_at&.strftime("%Y/%m/%d %H:%M") %></small>
          </p>
        <% end %>

        <%= button_to "お気に入り解除", favorite_path(cast), method: :delete, class: "btn secondary" %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="region-note">まだお気に入りの女の子がいません。気になる女の子のページから「お気に入りに追加」してみましょう。</p>
<% end %>
