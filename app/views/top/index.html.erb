<% content_for :title, "FuzokuZero | ゼロから始める風俗体験" %>
<% content_for :meta_description, "FuzokuZeroは、全国の風俗店・在籍キャストをエリア・ジャンル・料金から探せるポータルサイトです。" %>

<div class="top-gate">
  <div class="top-gate-eyecatch">
    <%= site_index_image_tag :eyecatch, alt: "FuzokuZero" %>
  </div>

  <h1 class="top-gate-heading">エリアを選択してください</h1>

  <div class="top-gate-map">
    <%= site_index_image_tag :map, alt: "エリア選択マップ", class: "top-gate-map-img" %>

    <div class="top-gate-region-buttons">
      <%= link_to "関東版はこちら", kanto_home_path, class: "btn top-gate-region-btn" %>
      <%= link_to "中部版はこちら", chubu_home_path, class: "btn top-gate-region-btn" %>
    </div>
  </div>

  <p class="top-gate-age-check">
    <%= link_to "18歳未満はこちら", "https://www.google.com/", class: "top-gate-age-link" %>
  </p>
</div>
