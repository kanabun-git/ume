<% if member_rank.errors.any? %>
  <div class="errors">
    <ul>
      <% member_rank.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: member_rank, url: url, local: true, class: "form" do |f| %>
  <label>ランク名</label>
  <%= f.text_field :name %>

  <label>必要承認数(この件数以上の承認済み口コミでこのランクになります)</label>
  <%= f.number_field :min_approved_count %>

  <%= f.submit "保存する", class: "btn" %>
<% end %>
