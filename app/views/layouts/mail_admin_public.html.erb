<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "メールアドレス管理" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body>
    <%# Login and password-reset screens on the mail admin domain: same shell
        as the management screen itself, with no portal branding anywhere. %>
    <div class="mail-admin-shell">
      <header class="mail-admin-header">
        <span class="mail-admin-brand">メールアドレス管理</span>
      </header>
      <main class="mail-admin-content mail-admin-public">
        <% if notice %><div class="notice"><%= notice %></div><% end %>
        <% if alert %><div class="alert"><%= alert %></div><% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
