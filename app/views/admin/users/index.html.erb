<% content_for :title, "ユーザー管理" %>

<h1>ユーザー管理</h1>
<%= link_to "新規ユーザー登録", new_admin_user_path, class: "btn" %>

<table class="admin-table">
  <thead><tr><th>名前</th><th>メールアドレス</th><th>ロール</th><th>所属店舗</th><th></th></tr></thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.role %></td>
        <td><%= user.shop&.name %></td>
        <td>
          <%= link_to "編集", edit_admin_user_path(user) %>
          <%= button_to "削除", admin_user_path(user), method: :delete, form: { data: { turbo_confirm: "削除してよろしいですか?" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
