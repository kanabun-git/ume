<%
  quick_nav_items = [{ label: "トップ", url: shop_path(shop, anchor: "top") }]
  quick_nav_items << { label: "写メ日記", url: shop_path(shop, anchor: "block-diaries_list") } if shop.shop_page_blocks.visible.exists?(block_type: :diaries_list)
  quick_nav_items << { label: "出勤情報", url: shop_path(shop, anchor: "block-weekly_schedule") } if shop.shop_page_blocks.visible.exists?(block_type: :weekly_schedule)
  if shop.shop_page_blocks.visible.exists?(block_type: :casts)
    quick_nav_items << { label: "女の子", url: shop_path(shop, anchor: "block-casts"), badge: (shop.casts.visible.trial.any? ? "新人入店" : nil) }
  end
  quick_nav_items << { label: "動画", url: shop_path(shop, anchor: "block-movie") } if shop.shop_page_blocks.visible.exists?(block_type: :movie)
  if shop.shop_page_blocks.visible.exists?(block_type: :coupons) && shop.coupons.active.any?
    quick_nav_items << { label: "クーポン", url: shop_path(shop, anchor: "block-coupons") }
  end
  quick_nav_items << { label: "口コミ", url: shop_reviews_path(shop) }
  if shop.shop_page_blocks.visible.exists?(block_type: :recruiting) && (shop.recruiting_cast? || shop.recruiting_staff?)
    quick_nav_items << { label: "求人情報", url: shop_path(shop, anchor: "block-recruiting") }
  end
%>
<nav class="quick-nav-bar">
  <% quick_nav_items.each do |item| %>
    <%= link_to item[:url], class: "quick-nav-item" do %>
      <%= item[:label] %>
      <% if item[:badge] %><span class="quick-nav-badge"><%= item[:badge] %></span><% end %>
    <% end %>
  <% end %>
</nav>
