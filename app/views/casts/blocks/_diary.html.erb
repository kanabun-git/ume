<% entries = cast.diary_entries.visible.limit(10) %>
<% if entries.any? %>
  <div class="girl-diary-grid">
    <% entries.each do |entry| %>
      <%= link_to cast_path(cast, anchor: "diary-#{entry.id}"), class: "girl-diary-thumb" do %>
        <div class="photo-with-status">
          <%= diary_thumb_tag entry %>
          <% if entry.video.attached? && !entry.video_hidden? %>
            <span class="badge">動画あり</span>
          <% end %>
        </div>
        <span><%= truncate(entry.title, length: 16) %></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p>まだ日記の投稿がありません。</p>
<% end %>
