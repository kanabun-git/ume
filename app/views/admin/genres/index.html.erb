<% content_for :title, "ジャンル管理" %>

<h1>ジャンル管理</h1>
<%= link_to "新規ジャンル登録", new_admin_genre_path, class: "btn" %>

<table class="admin-table">
  <thead><tr><th>名前</th><th>並び順</th><th></th></tr></thead>
  <tbody>
    <% @genres.each do |genre| %>
      <tr>
        <td><%= genre.name %></td>
        <td><%= genre.position %></td>
        <td>
          <%= link_to "編集", edit_admin_genre_path(genre) %>
          <%= button_to "削除", admin_genre_path(genre), method: :delete, form: { data: { turbo_confirm: "削除してよろしいですか?" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
