<% photos = cast.visible_photos %>
<div class="girl-main-image-row">
  <% if photos.size > 1 %>
    <button type="button" class="girl-gallery-arrow" onclick="girlGalleryMove(-1)" aria-label="前の画像">‹</button>
  <% end %>
  <div class="girl-main-image">
    <%= photo_or_placeholder_tag photos.first, removed: cast.photos_removed_by_moderation?, id: "girl-main-image" %>
  </div>
  <% if photos.size > 1 %>
    <button type="button" class="girl-gallery-arrow" onclick="girlGalleryMove(1)" aria-label="次の画像">›</button>
  <% end %>
</div>
<% if photos.size > 1 %>
  <div class="girl-thumbs">
    <% photos.each_with_index do |photo, index| %>
      <%= image_tag photo, onclick: "girlGallerySet(#{index})" %>
    <% end %>
  </div>
  <script>
    (function() {
      var urls = <%= raw photos.map { |p| url_for(p) }.to_json %>;
      var current = 0;
      var img = document.getElementById("girl-main-image");
      window.girlGallerySet = function(index) {
        current = index;
        img.src = urls[current];
      };
      window.girlGalleryMove = function(delta) {
        current = (current + delta + urls.length) % urls.length;
        img.src = urls[current];
      };
    })();
  </script>
<% end %>
