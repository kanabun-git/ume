<% content_for :title, "FuzokuZero #{@region}版 | ゼロから始める風俗体験" %>
<% content_for :meta_description, "FuzokuZero #{@region}版は、#{@region}エリアの風俗店・在籍キャストをエリア・ジャンル・料金から探せるポータルサイトです。口コミ・写メ日記・出勤情報もチェックできます。" %>

<div class="hero">
  <h1 class="hero-title"><%= @region %>版 お店・キャストを探す</h1>
  <p class="region-switch"><%= link_to "地域を変更する >", root_path, class: "home-section-more" %></p>
  <%= form_with url: shops_path, method: :get, local: true, class: "hero-search" do |f| %>
    <div class="hero-search-row">
      <div class="hero-search-field">
        <label>エリア</label>
        <%= f.select :area_id, @areas.flat_map { |pref| [[pref.name, pref.id]] + pref.children.map { |c| ["　" + c.name, c.id] } }, { include_blank: "エリアを選択" } %>
      </div>
      <div class="hero-search-field">
        <label>ジャンル</label>
        <%= f.select :genre_id, options_from_collection_for_select(@genres, :id, :name), { include_blank: "ジャンルを選択" } %>
      </div>
      <div class="hero-search-field">
        <label>キーワード</label>
        <%= f.text_field :keyword, placeholder: "店舗名など" %>
      </div>
      <button type="submit" class="btn hero-search-btn">この条件で探す</button>
    </div>
  <% end %>
</div>

<section class="home-section">
  <div class="home-section-head">
    <h2><%= @region %>マップから探す</h2>
    <%= link_to "エリア一覧を見る >", shops_path, class: "home-section-more" %>
  </div>
  <div class="region-explorer">
    <%= render "region_image_map", region: @region, areas: @areas %>

    <div class="region-block">
      <div class="area-grid">
        <% @areas.each do |area| %>
          <div class="area-block">
            <h4><%= link_to area.name, area_path(area) %></h4>
            <ul class="area-children">
              <% area.children.each do |child| %>
                <li><%= link_to child.name, area_path(child) %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="home-section">
  <div class="home-section-head">
    <h2>本日出勤中の女の子</h2>
    <%= link_to "出勤一覧を見る >", today_shifts_path, class: "home-section-more" %>
  </div>
  <% if @today_shifts.any? %>
    <div class="weekly-day-grid today-shifts-grid">
      <%= render partial: "today_shifts/shift_card", collection: @today_shifts, as: :shift %>
    </div>
  <% else %>
    <p class="region-note">本日出勤予定の女の子はいません。</p>
  <% end %>
</section>

<section class="home-section">
  <div class="home-section-head">
    <h2>ジャンルから探す</h2>
  </div>
  <div class="genre-pills">
    <% @genres.each do |genre| %>
      <%= link_to genre.name, genre_path(genre), class: "genre-pill" %>
    <% end %>
  </div>
</section>

<section class="home-section">
  <div class="home-section-head">
    <h2>本日の人気店ランキング</h2>
    <%= link_to "ランキング全体を見る >", rankings_path, class: "home-section-more" %>
  </div>
  <ol class="ranking-list">
    <% @ranked_shops.each_with_index do |shop, i| %>
      <li class="ranking-item">
        <span class="ranking-rank rank-<%= i + 1 <= 3 ? i + 1 : "other" %>"><%= i + 1 %></span>
        <%= link_to shop_path(shop), class: "ranking-thumb" do %>
          <% if shop.photos.attached? %>
            <%= image_tag shop.photos.first %>
          <% else %>
            <div class="ranking-thumb-placeholder"></div>
          <% end %>
        <% end %>
        <div class="ranking-body">
          <h3><%= link_to shop.name, shop_path(shop) %></h3>
          <div><span class="badge"><%= shop.genre.name %></span> <span class="badge muted"><%= shop.area.name %></span></div>
          <p><%= truncate(shop.catch_copy.to_s, length: 50) %></p>
        </div>
      </li>
    <% end %>
  </ol>
</section>

<section class="home-section">
  <div class="home-section-head">
    <h2>クーポン</h2>
    <%= link_to "クーポン一覧を見る >", coupons_path, class: "home-section-more" %>
  </div>
  <% if @coupon_shops.any? %>
    <div class="shop-listing">
      <% @coupon_shops.each do |shop| %>
        <%= render "shops/shop_card", shop: shop %>
      <% end %>
    </div>
  <% else %>
    <p class="region-note">現在クーポンを実施中の店舗はありません。</p>
  <% end %>
</section>

<section class="home-section">
  <div class="home-section-head">
    <h2>体験動画</h2>
    <%= link_to "動画一覧を見る >", videos_path, class: "home-section-more" %>
  </div>
  <% if @latest_videos.any? %>
    <div class="video-grid">
      <%= render partial: "videos/video_card", collection: @latest_videos, as: :video %>
    </div>
  <% else %>
    <p class="region-note">まだ動画がありません。</p>
  <% end %>
</section>

<section class="home-section">
  <div class="home-section-head">
    <h2>新着日記</h2>
  </div>
  <div class="grid">
    <% @latest_diary_entries.each do |entry| %>
      <div class="card diary-card">
        <h3><%= link_to entry.title, cast_path(entry.cast) %></h3>
        <p class="diary-meta"><%= entry.cast.name %>(<%= link_to entry.cast.shop.name, shop_path(entry.cast.shop) %>)</p>
        <p><%= truncate(entry.body, length: 60) %></p>
      </div>
    <% end %>
  </div>
</section>
