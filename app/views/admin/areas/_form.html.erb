<% if area.errors.any? %>
  <div class="errors">
    <ul>
      <% area.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: area, url: url, local: true, class: "form" do |f| %>
  <label>名前</label>
  <%= f.text_field :name %>

  <label>ふりがな</label>
  <%= f.text_field :name_kana %>

  <label>スラッグ(URL用、半角英数字とハイフン)</label>
  <%= f.text_field :slug %>

  <label>地方(都道府県の場合のみ指定)</label>
  <%= f.select :region, Area::REGIONS, include_blank: true %>

  <label>親エリア(都道府県の場合は空欄)</label>
  <%= f.collection_select :parent_id, Area.where(parent_id: nil).where.not(id: area.id), :id, :name, include_blank: true %>

  <label>並び順</label>
  <%= f.number_field :position %>

  <%= f.submit "保存する", class: "btn" %>
<% end %>
