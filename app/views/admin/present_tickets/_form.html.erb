<% if present_ticket.errors.any? %>
  <div class="errors">
    <ul>
      <% present_ticket.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: present_ticket, url: url, local: true, multipart: true, class: "form" do |f| %>
  <label>企画名</label>
  <%= f.text_field :name %>

  <label>バナー画像(任意。企画カードの上部に横長で表示されます。推奨サイズ: <%= PresentTicket::RECOMMENDED_BANNER_SIZE %>。5MBまで、JPEG・PNG・WEBP)</label>
  <% if present_ticket.banner_image.attached? %>
    <div class="grid">
      <%= image_tag present_ticket.banner_image, style: "max-width:300px;" %>
    </div>
    <label><%= check_box_tag "present_ticket[remove_banner_image]", "1" %> 現在のバナー画像を削除する</label>
  <% end %>
  <%= f.file_field :banner_image, accept: "image/jpeg,image/png,image/webp" %>

  <label>バナー画像が未設定の場合の表示</label>
  <%= f.select :fallback_banner, PresentTicket::FALLBACK_BANNER_LABELS.map { |value, label| [label, value] } %>

  <label>説明(バナー画像の下に表示されます)</label>
  <%= f.text_area :description %>

  <label>当選人数</label>
  <%= f.number_field :capacity %>

  <label>応募締切日時</label>
  <%= f.datetime_field :deadline_at %>

  <%= f.submit "保存する", class: "btn" %>
<% end %>
