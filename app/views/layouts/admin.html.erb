<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "運営管理画面 | FuzokuZero" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body>
    <div class="admin-shell">
      <div class="sidebar">
        <div class="brand">運営管理画面</div>
        <%= link_to "ダッシュボード", admin_root_path %>
        <%= link_to "店舗管理", admin_shops_path %>
        <%= link_to "エリア管理", admin_areas_path %>
        <%= link_to "ジャンル管理", admin_genres_path %>
        <%= link_to "プラン管理", admin_plans_path %>
        <%= link_to "契約管理", admin_shop_subscriptions_path %>
        <%= link_to "体験動画管理", admin_videos_path %>
        <%= link_to "営業先候補管理", admin_shop_prospects_path %>
        <%= link_to "口コミモデレーション", admin_reviews_path %>
        <%= link_to "掲載のお問い合わせ", admin_shop_inquiries_path %>
        <%= link_to "女の子画像の確認", admin_cast_images_path %>
        <%= link_to "写メ日記画像の確認", admin_diary_images_path %>
        <%= link_to "ユーザー管理", admin_users_path %>
        <%= link_to "会員ランク管理", admin_member_ranks_path %>
        <%= link_to "アクセス解析", admin_analytics_path %>
        <%= link_to "サイト基本設定", edit_admin_basic_setting_path %>
        <%= link_to "サイト設定", edit_admin_setting_path %>
        <%= link_to "データバックアップ", admin_data_backups_path %>
        <%= link_to "サイトを見る", root_path %>
        <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "link-button" %>
      </div>
      <div class="content">
        <% if notice %><div class="notice"><%= notice %></div><% end %>
        <% if alert %><div class="alert"><%= alert %></div><% end %>
        <%= yield %>
      </div>
    </div>
    <div class="build-version"><%= BuildVersion.display %></div>
    <%= render "layouts/turbo_confirm_shim" %>
  </body>
</html>
