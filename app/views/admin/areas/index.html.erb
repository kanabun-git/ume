<% content_for :title, "エリア管理" %>

<h1>エリア管理</h1>

<div class="card">
  <h2>CSV一括登録</h2>
  <p>
    <%= link_to "CSVテンプレートをダウンロード", template_admin_areas_path, class: "btn secondary" %>
  </p>
  <%= form_with url: import_admin_areas_path, method: :post, local: true, multipart: true, class: "form" do %>
    <label>CSVファイル(名前,カナ,スラッグ,地方,表示順,親エリアのスラッグ)</label>
    <p>都道府県の行は「親エリアのスラッグ」を空欄にしてください。子エリアの行は、対象の都道府県より後の行に置いてください。</p>
    <%= file_field_tag :file, accept: ".csv,text/csv" %>
    <%= submit_tag "アップロードして登録する", class: "btn" %>
  <% end %>
  <p>
    <%= link_to "登録済みのエリアをCSVダウンロード", export_admin_areas_path, class: "btn secondary" %>
  </p>
</div>

<%= link_to "新規エリア登録", new_admin_area_path, class: "btn" %>

<table class="admin-table">
  <thead><tr><th>名前</th><th>地方</th><th>親エリア</th><th>並び順</th><th></th></tr></thead>
  <tbody>
    <% @areas.each do |area| %>
      <tr>
        <td><%= area.name %></td>
        <td><%= area.region %></td>
        <td><%= area.parent&.name %></td>
        <td><%= area.position %></td>
        <td>
          <%= link_to "編集", edit_admin_area_path(area.id) %>
          <%= button_to "削除", admin_area_path(area.id), method: :delete, form: { data: { turbo_confirm: "削除してよろしいですか?" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
