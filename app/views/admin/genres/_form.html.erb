<% if genre.errors.any? %>
  <div class="errors">
    <ul>
      <% genre.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: genre, url: url, local: true, class: "form" do |f| %>
  <label>名前</label>
  <%= f.text_field :name %>

  <label>スラッグ(URL用、半角英数字とハイフン)</label>
  <%= f.text_field :slug %>

  <label>並び順</label>
  <%= f.number_field :position %>

  <%= f.submit "保存する", class: "btn" %>
<% end %>
