<% content_for :title, "判定結果 | 古着ブランド判定ツール" %>

<section class="vintage-section container vintage-section-narrow">
  <h1>判定結果</h1>

  <% if @result.empty? %>
    <div class="vintage-result-empty">
      <p>いただいた情報だけではブランド・年代を推定できませんでした。</p>
      <% if @result.next_checks.any? %>
        <p>次の箇所を撮影して、もう一度お試しください。</p>
        <ul>
          <% @result.next_checks.each do |check| %><li><%= check %></li><% end %>
        </ul>
      <% end %>
    </div>
  <% else %>
    <% if @result.summary.present? %>
      <p class="vintage-result-summary"><%= @result.summary %></p>
    <% end %>

    <div class="vintage-result-facts">
      <% if @result.item_type.present? %>
        <div><span class="vintage-result-label">アイテム</span><span><%= @result.item_type %></span></div>
      <% end %>
      <% if @result.era.present? %>
        <div><span class="vintage-result-label">推定年代</span><span><%= @result.era %></span></div>
      <% end %>
      <% if @result.origin.present? %>
        <div><span class="vintage-result-label">生産国</span><span><%= @result.origin %></span></div>
      <% end %>
      <% if @result.target_gender.present? %>
        <div><span class="vintage-result-label">対象</span><span><%= @result.target_gender %></span></div>
      <% end %>
      <% if @result.target_age.present? %>
        <div><span class="vintage-result-label">想定年齢層</span><span><%= @result.target_age %></span></div>
      <% end %>
    </div>

    <% if @result.brand_candidates.any? %>
      <h2>ブランド候補</h2>
      <ol class="vintage-candidates">
        <% @result.brand_candidates.each do |candidate| %>
          <li class="vintage-candidate">
            <div class="vintage-candidate-head">
              <span class="vintage-candidate-name"><%= candidate.name %></span>
              <span class="vintage-confidence vintage-confidence-<%= candidate.confidence || "unknown" %>">
                確度: <%= candidate.confidence_label %>
              </span>
            </div>
            <% if candidate.reason.present? %>
              <p><%= candidate.reason %></p>
            <% end %>
            <% if candidate.guide_slug.present? %>
              <p><%= link_to "このブランドのタグ変遷を見る →", vintage_guide_path(anchor: candidate.guide_slug), class: "vintage-link" %></p>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>

    <% if @result.original_price.present? %>
      <h2>新品時の定価の目安</h2>
      <div class="vintage-price vintage-price-secondary">
        <p class="vintage-price-range"><%= @result.original_price.range_label %></p>
        <% if @result.original_price.note.present? %>
          <p class="vintage-price-note"><%= @result.original_price.note %></p>
        <% end %>
        <% if @result.target_age_reason.present? %>
          <p class="vintage-price-note">想定年齢層の根拠: <%= @result.target_age_reason %></p>
        <% end %>
        <p class="vintage-note">
          対象・想定年齢層は<strong>そのブランドが購買層として想定している区分</strong>で、この品を着ていた人のことではありません。
        </p>
      </div>
    <% end %>

    <% if @result.market_price.present? %>
      <h2>中古相場の目安</h2>
      <div class="vintage-price">
        <p class="vintage-price-range"><%= @result.market_price.range_label %></p>
        <% if @result.market_price.note.present? %>
          <p class="vintage-price-note"><%= @result.market_price.note %></p>
        <% end %>
        <% if @result.market_price.factors.any? %>
          <ul class="vintage-list">
            <% @result.market_price.factors.each do |factor| %><li><%= factor %></li><% end %>
          </ul>
        <% end %>
        <p class="vintage-note">
          フリマアプリや古着屋で<strong>売られている</strong>価格の目安です(買い取ってもらう金額はこれより低くなります)。
          状態・サイズ・時期で大きく上下するため、実際の取引の前に必ず現在の出品価格をご確認ください。
        </p>
        <% if @result.market_search_keyword.present? %>
          <p class="vintage-price-search">
            実際の出品を見る:
            <%= link_to "メルカリ", "https://jp.mercari.com/search?keyword=#{CGI.escape(@result.market_search_keyword)}",
                  class: "vintage-link", target: "_blank", rel: "noopener" %>
            /
            <%= link_to "ヤフオク", "https://auctions.yahoo.co.jp/search/search?p=#{CGI.escape(@result.market_search_keyword)}",
                  class: "vintage-link", target: "_blank", rel: "noopener" %>
          </p>
        <% end %>
      </div>
    <% end %>

    <% if @result.era_reason.present? %>
      <h2>年代の根拠</h2>
      <p><%= @result.era_reason %></p>
    <% end %>

    <% if @result.clues.any? %>
      <h2>読み取れた手がかり</h2>
      <ul class="vintage-list">
        <% @result.clues.each do |clue| %><li><%= clue %></li><% end %>
      </ul>
    <% end %>

    <% if @result.authenticity_notes.any? %>
      <h2>確認しておきたい点</h2>
      <ul class="vintage-list">
        <% @result.authenticity_notes.each do |note| %><li><%= note %></li><% end %>
      </ul>
    <% end %>

    <% if @result.next_checks.any? %>
      <h2>さらに絞り込むには</h2>
      <ul class="vintage-list">
        <% @result.next_checks.each do |check| %><li><%= check %></li><% end %>
      </ul>
    <% end %>
  <% end %>

  <p class="vintage-note">
    判定結果・相場価格はAIによる推定です。真贋・年代・取引価格を保証するものではありません。
  </p>

  <p><%= link_to "別のアイテムを判定する →", vintage_root_path, class: "btn" %></p>
</section>
