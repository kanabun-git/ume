<% entries = DiaryEntry.visible.joins(:cast).where(casts: { shop_id: shop.id }).limit(10) %>
<% if entries.any? %>
  <div class="girl-diary-grid">
    <% entries.each do |entry| %>
      <%= link_to cast_path(entry.cast, anchor: "diary-#{entry.id}"), class: "girl-diary-thumb" do %>
        <div class="photo-with-status">
          <% if entry.visible_images.any? %>
            <%= image_tag entry.visible_images.first %>
          <% elsif entry.video.attached? %>
            <%= video_tag entry.video, muted: true, preload: "metadata" %>
          <% else %>
            <%= image_tag "nowprinting.svg" %>
          <% end %>
          <% if entry.video.attached? %>
            <span class="badge">動画あり</span>
          <% end %>
        </div>
        <span><%= truncate(entry.title, length: 16) %></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p>まだ日記の投稿がありません。</p>
<% end %>
