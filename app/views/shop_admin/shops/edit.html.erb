<% content_for :title, "店舗情報編集" %>

<h1>店舗情報編集</h1>

<% if @shop.errors.any? %>
  <div class="errors">
    <ul>
      <% @shop.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @shop, url: shop_admin_shop_path, method: :patch, local: true, class: "form" do |f| %>
  <p>店舗名・エリア・ジャンル・プランの変更は運営者にお問い合わせください。</p>

  <label>キャッチコピー</label>
  <%= f.text_field :catch_copy %>

  <label>店舗紹介</label>
  <%= f.text_area :description %>

  <label>住所</label>
  <%= f.text_field :address %>

  <label>電話番号</label>
  <%= f.text_field :phone %>

  <label>営業時間</label>
  <%= f.text_field :business_hours %>

  <label>時刻の表記方法(出勤時間の表示に適用されます)</label>
  <%= f.select :time_display_format, Shop::TIME_DISPLAY_FORMAT_LABELS.map { |value, label| [label, value] } %>

  <label>料金(例: 50分10000円〜)</label>
  <%= f.text_field :price_note %>

  <label>最低料金(円。店舗検索の料金絞り込みに使われます)</label>
  <%= f.number_field :min_price %>

  <label>交通費(例: 0〜1000円)</label>
  <%= f.text_field :transportation_fee_note %>

  <label>対応エリア(例: 柏駅発着、流山、松戸、野田)</label>
  <%= f.text_field :coverage_area_note %>

  <label>PRバッジ表示期限(この日時まで「PR」バッジが店舗一覧・詳細ページに表示されます。空欄にすると非表示になります)</label>
  <%= f.datetime_field :pr_badge_until %>

  <label>掲載バッジ</label>
  <label><%= f.check_box :online_reservation %> ネット予約</label>
  <label><%= f.check_box :visit_point_program %> 来店ポイント</label>
  <label><%= f.check_box :coupon_available %> クーポン</label>
  <label><%= f.check_box :event_ongoing %> イベント開催中</label>
  <label><%= f.check_box :recruiting_cast %> コンパニオン募集</label>
  <label><%= f.check_box :recruiting_staff %> スタッフ募集</label>

  <label>クーポン内容(クーポンONの場合に表示)</label>
  <%= f.text_area :coupon_description %>

  <label>求人情報</label>
  <%= f.text_area :recruiting_message %>

  <label>店舗写真を追加(既存の写真は残ったまま追加されます。最大5枚まで)</label>
  <%= f.file_field :photos, multiple: true %>

  <% if @shop.photos.attached? %>
    <div class="grid">
      <%# Skip not-yet-persisted attachments: if a previous submit failed
          validation, newly-selected files are staged in memory only and
          have no signed_id yet — rendering them would raise. %>
      <% @shop.photos.select(&:persisted?).each do |photo| %>
        <%= image_tag photo, style: "max-width:120px;" %>
      <% end %>
    </div>
  <% end %>

  <h2>店舗詳細ページのデザイン</h2>
  <p><small>店舗詳細ページ(会員・一般ユーザーが見る画面)の背景色・文字色・基調色(ボタンやバッジの色)・背景画像を、サイト標準のデザインから変更できます。空欄のままにすると標準デザインのままになります。</small></p>

  <label>背景色</label>
  <%= f.color_field :page_background_color, value: @shop.page_background_color.presence || "#f7f2f0" %>

  <label>基調文字色</label>
  <%= f.color_field :page_text_color, value: @shop.page_text_color.presence || "#1a1a1a" %>

  <label>基調色(ボタン・バッジなどのアクセントカラー)</label>
  <%= f.color_field :page_accent_color, value: @shop.page_accent_color.presence || "#e0356b" %>

  <label>背景画像(任意。設定すると背景色より優先して表示されます)</label>
  <%= f.file_field :page_background_image %>

  <% if @shop.page_background_image.attached? %>
    <div class="grid">
      <%= image_tag @shop.page_background_image, style: "max-width:200px;" %>
    </div>
    <label><%= check_box_tag "shop[remove_page_background_image]", "1" %> 現在の背景画像を削除する</label>
  <% end %>

  <%= f.submit "更新する", class: "btn" %>
<% end %>
