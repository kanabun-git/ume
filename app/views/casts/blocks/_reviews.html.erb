<% reviews = cast.reviews.approved.limit(10) %>
<% if reviews.any? %>
  <% reviews.each do |review| %>
    <div class="cast-review-item">
      <p class="stars">評価: <%= review.rating %> / 5</p>
      <p><%= review.body %></p>
      <p><small><%= review.reviewer_name %> - <%= review.created_at.strftime("%Y-%m-%d") %></small></p>
    </div>
  <% end %>
<% else %>
  <p>まだ口コミがありません。</p>
<% end %>
