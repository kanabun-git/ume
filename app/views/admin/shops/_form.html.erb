<% if shop.errors.any? %>
  <div class="errors">
    <ul>
      <% shop.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: shop, url: url, local: true, class: "form" do |f| %>
  <label>店舗名</label>
  <%= f.text_field :name %>

  <label>エリア</label>
  <%= f.collection_select :area_id, Area.all, :id, :name %>

  <label>ジャンル</label>
  <%= f.collection_select :genre_id, Genre.all, :id, :name %>

  <label>プラン</label>
  <%= f.collection_select :plan_id, Plan.all, :id, :name %>

  <label>キャッチコピー</label>
  <%= f.text_field :catch_copy %>

  <label>店舗紹介</label>
  <%= f.text_area :description %>

  <label>住所</label>
  <%= f.text_field :address %>

  <label>電話番号</label>
  <%= f.text_field :phone %>

  <label>営業時間</label>
  <%= f.text_field :business_hours %>

  <label>店舗写真</label>
  <%= f.file_field :photos, multiple: true %>

  <%= f.submit "保存する", class: "btn" %>
<% end %>
