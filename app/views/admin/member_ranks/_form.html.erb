<% if member_rank.errors.any? %>
  <div class="errors">
    <ul>
      <% member_rank.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: member_rank, url: url, local: true, multipart: true, class: "form" do |f| %>
  <label>ランク名</label>
  <%= f.text_field :name %>

  <label>必要承認数(この件数以上の承認済み口コミでこのランクになります)</label>
  <%= f.number_field :min_approved_count %>

  <label>カード画像(このランクの会員証のベースデザイン。未設定の場合はサイト共通の会員証画像が使われます)</label>
  <% if member_rank.card_image.attached? %>
    <div class="image-setting-preview">
      <%= image_tag member_rank.card_image %>
    </div>
    <label class="checkbox-inline">
      <%= check_box_tag "member_rank[remove_card_image]", "1" %>
      現在の画像を削除する(サイト共通の会員証画像に戻します)
    </label>
  <% end %>
  <p class="region-note">新しい画像を選択すると、現在の画像と入れ替わります。</p>
  <%= f.file_field :card_image, accept: "image/jpeg,image/png,image/webp" %>

  <%= f.submit "保存する", class: "btn" %>
<% end %>
