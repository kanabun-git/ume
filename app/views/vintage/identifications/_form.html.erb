<% if identification.errors.any? %>
  <div class="errors">
    <ul>
      <% identification.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: identification, url: vintage_identifications_path, scope: :vintage_identification, local: true, class: "form vintage-form", multipart: true do |f| %>
  <label>タグ・アイテムの写真(<%= Vintage::Identification::MAX_IMAGES %>枚まで)</label>
  <p class="vintage-field-hint">
    ブランドタグ、品質表示・洗濯表示、縫い目、アイテム全体 -- この順で撮ると判定の精度が上がります。
    文字がはっきり読める明るさで撮影してください。下着・インナーの場合は、サイズ表記(B70・C75など)と
    品質表示タグが読めるように撮ってください。
    <strong>着用した状態ではなく、商品単体を平置きで撮影してください</strong>(写真は判定のため外部のAIへ送信されます)。
    アップロード時に自動で縮小するので、スマートフォンの写真をそのまま選んで構いません。
  </p>
  <%= f.file_field :images, multiple: true, accept: Vintage::Identification::PERMITTED_IMAGE_TYPES.join(",") %>

  <label>アイテムの種類(任意)</label>
  <%= f.select :item_type, Vintage::Identification::ITEM_TYPES, { include_blank: "選択してください" } %>

  <label>コンディション(任意)</label>
  <p class="vintage-field-hint">
    中古相場の目安は、ここで選んだ状態を前提に見積もります。未選択の場合は
    「目立った傷や汚れなし」相当として計算します。
  </p>
  <%= f.select :condition, Vintage::Identification::CONDITIONS, { include_blank: "選択してください" } %>

  <label>サイズ表記・実寸(任意)</label>
  <p class="vintage-field-hint">例:「タグ表記M」「肩幅48cm 身幅55cm」。大きいサイズほど相場が上がる品もあります。</p>
  <%= f.text_field :size_note, maxlength: Vintage::Identification::MAX_SIZE_NOTE_LENGTH %>

  <label>タグに書かれている内容・気づいた点(任意)</label>
  <p class="vintage-field-hint">
    例:「タグに MADE IN USA と RN 番号あり」「袖の縫い目が1本」「50/50 の表記」など。
    写真が無くても、この欄だけで判定を試すことができます。
  </p>
  <%= f.text_area :notes, rows: 5, maxlength: Vintage::Identification::MAX_NOTES_LENGTH %>

  <%= f.submit "判定する", class: "btn", data: { turbo_submits_with: "判定中..." } %>
  <p class="vintage-field-hint">判定には20〜30秒ほどかかります。ボタンは一度だけ押して、そのままお待ちください。</p>
<% end %>

<script>
  // スマートフォンの写真は1枚3〜5MBあり、上限枚数まで選ぶと送信サイズが
  // AI側の上限(20MB)を超える。タグの文字が読めれば判定はできるので、
  // 送信前にブラウザ側で長辺1600pxまで縮める。
  // 失敗した場合は元のファイルのまま送る(サーバー側にも合計サイズの検証がある)。
  (function() {
    var MAX_EDGE = 1600;
    var QUALITY = 0.82;

    var form = document.querySelector("form.vintage-form");
    if (!form || !window.DataTransfer || !window.FileReader) return;

    var input = form.querySelector("input[type=file]");
    if (!input) return;

    var resized = false;

    function shrink(file) {
      return new Promise(function(resolve) {
        // 縮小しても小さくならないものはそのまま返す。
        if (!file.type.startsWith("image/") || file.type === "image/gif" || file.size < 400 * 1024) {
          resolve(file);
          return;
        }

        var url = URL.createObjectURL(file);
        var img = new Image();

        img.onload = function() {
          URL.revokeObjectURL(url);
          var scale = Math.min(1, MAX_EDGE / Math.max(img.width, img.height));
          if (scale === 1) { resolve(file); return; }

          var canvas = document.createElement("canvas");
          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);
          canvas.getContext("2d").drawImage(img, 0, 0, canvas.width, canvas.height);

          canvas.toBlob(function(blob) {
            if (!blob || blob.size >= file.size) { resolve(file); return; }
            resolve(new File([blob], file.name.replace(/\.[^.]+$/, "") + ".jpg", { type: "image/jpeg" }));
          }, "image/jpeg", QUALITY);
        };

        img.onerror = function() { URL.revokeObjectURL(url); resolve(file); };
        img.src = url;
      });
    }

    form.addEventListener("submit", function(event) {
      if (resized || input.files.length === 0) return;

      event.preventDefault();
      Promise.all(Array.prototype.map.call(input.files, shrink)).then(function(files) {
        var box = new DataTransfer();
        files.forEach(function(file) { box.items.add(file); });
        input.files = box.files;
        resized = true;
        form.requestSubmit ? form.requestSubmit() : form.submit();
      }).catch(function() {
        resized = true;
        form.requestSubmit ? form.requestSubmit() : form.submit();
      });
    });
  })();
</script>
