<% if block.errors.any? %>
  <div class="errors">
    <ul>
      <% block.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: block, url: url, local: true, class: "form" do |f| %>
  <label>ブロックの種類</label>
  <%= f.select :block_type, ShopPageBlock::LABELS.map { |type, label| [label, type] }, {}, disabled: block.persisted? %>
  <% if block.persisted? %>
    <%= f.hidden_field :block_type %>
    <p><small>種類は追加後に変更できません。削除して作り直してください。</small></p>
  <% end %>

  <label>タイトル(空欄の場合は種類ごとの標準タイトルを表示)</label>
  <%= f.text_field :title %>

  <label>表示する</label>
  <%= f.check_box :visible %>

  <label>背景色(空欄でデフォルト)</label>
  <%= f.color_field :background_color, value: block.background_color.presence || "#ffffff" %>

  <label>背景の不透明度(0〜1)</label>
  <%= f.number_field :background_opacity, min: 0, max: 1, step: 0.05 %>

  <% if block.block_type == "free_text" %>
    <label>本文</label>
    <%= text_area_tag "shop_page_block[settings][body]", block.settings["body"] %>
  <% elsif block.block_type == "movie" %>
    <label>動画ファイルをアップロード(MP4・MOV・WEBM、50MBまで)</label>
    <% if block.video_file.attached? %>
      <p><small>現在のファイル: <%= block.video_file.filename %>(新しいファイルを選ぶと置き換わります)</small></p>
    <% end %>
    <%= f.file_field :video_file, accept: "video/mp4,video/quicktime,video/webm" %>

    <label>または動画URL(YouTube埋め込みURL、またはmp4の直リンク。ファイルをアップロードした場合はそちらが優先されます)</label>
    <%= text_field_tag "shop_page_block[settings][video_url]", block.settings["video_url"] %>
  <% elsif block.block_type == "price_table" %>
    <%# Generic label/value row editor, reused for price tables, option
        tables, and per-area transportation fee tables: the block title
        (above) says what the table is, and each row is just a free-text
        label + value pair (e.g. "60分"/"12,000円" or "XX地区"/"1,000円"). %>
    <label>表の項目(項目名と金額・内容を自由に追加できます)</label>
    <% rows = block.settings["rows"].presence || [{}] %>
    <div id="price-table-rows">
      <% rows.each_with_index do |row, i| %>
        <div class="price-table-row-input">
          <%= text_field_tag "shop_page_block[settings][rows][#{i}][label]", row["label"], placeholder: "項目名(例: 60分、XX地区)" %>
          <%= text_field_tag "shop_page_block[settings][rows][#{i}][value]", row["value"], placeholder: "内容(例: 12,000円、1,000円)" %>
          <button type="button" class="btn secondary price-table-remove-row">削除</button>
        </div>
      <% end %>
    </div>
    <button type="button" id="price-table-add-row" class="btn secondary">項目を追加</button>

    <template id="price-table-row-template">
      <div class="price-table-row-input">
        <input type="text" name="shop_page_block[settings][rows][__INDEX__][label]" placeholder="項目名(例: 60分、XX地区)">
        <input type="text" name="shop_page_block[settings][rows][__INDEX__][value]" placeholder="内容(例: 12,000円、1,000円)">
        <button type="button" class="btn secondary price-table-remove-row">削除</button>
      </div>
    </template>

    <script>
      (function() {
        var container = document.getElementById("price-table-rows");
        var addBtn = document.getElementById("price-table-add-row");
        var template = document.getElementById("price-table-row-template");
        var index = <%= rows.size %>;

        addBtn.addEventListener("click", function() {
          var html = template.innerHTML.split("__INDEX__").join(index);
          container.insertAdjacentHTML("beforeend", html);
          index += 1;
        });

        container.addEventListener("click", function(event) {
          if (!event.target.classList.contains("price-table-remove-row")) return;
          var existingRows = container.querySelectorAll(".price-table-row-input");
          if (existingRows.length <= 1) {
            event.target.closest(".price-table-row-input").querySelectorAll("input").forEach(function(input) { input.value = ""; });
            return;
          }
          event.target.closest(".price-table-row-input").remove();
        });
      })();
    </script>
  <% end %>

  <%= f.submit "保存する", class: "btn" %>
<% end %>
