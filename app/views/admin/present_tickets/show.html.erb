<% content_for :title, @present_ticket.name %>

<h1><%= @present_ticket.name %></h1>
<p>店舗: <%= link_to @shop.name, admin_shop_path(@shop) %></p>
<p><span class="badge"><%= status_label(@present_ticket) %></span></p>

<% if (banner = present_ticket_banner_tag(@present_ticket, style: "max-width:400px;")) %>
  <p><%= banner %></p>
<% else %>
  <p><small>バナー画像は設定されていません(「編集」から設定できます)。</small></p>
<% end %>

<p><%= simple_format @present_ticket.description.to_s %></p>
<p>当選人数: <%= @present_ticket.capacity %>名 / 応募締切: <%= @present_ticket.deadline_at.strftime("%Y-%m-%d %H:%M") %></p>

<p>
  <%= link_to "編集", edit_admin_shop_present_ticket_path(@shop, @present_ticket), class: "btn secondary" %>
  <%= button_to "削除", admin_shop_present_ticket_path(@shop, @present_ticket), method: :delete, class: "btn danger", form: { data: { turbo_confirm: "削除してよろしいですか?" } } %>
</p>

<div class="card">
  <% if @present_ticket.accepting? %>
    <%= button_to "抽選する(応募者#{@entries.count}名から#{@present_ticket.capacity}名を抽選)", draw_admin_shop_present_ticket_path(@shop, @present_ticket), method: :post, class: "btn", form: { data: { turbo_confirm: "抽選を実行します。よろしいですか?(この操作は取り消せません)" } } %>
  <% else %>
    <%= button_to "当落メールを送信する(未送信#{@entries.where(notified_at: nil).where.not(status: :pending).count}件)", send_result_emails_admin_shop_present_ticket_path(@shop, @present_ticket), method: :post, class: "btn" %>
  <% end %>
</div>

<table class="admin-table">
  <thead><tr><th>会員</th><th>応募日時</th><th>結果</th><th>メール送信</th></tr></thead>
  <tbody>
    <% @entries.each do |entry| %>
      <tr>
        <td><%= entry.member.name %></td>
        <td><%= entry.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= status_label(entry) %></td>
        <td><%= entry.notified? ? entry.notified_at.strftime("%Y-%m-%d %H:%M") : "未送信" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "一覧に戻る", admin_shop_present_tickets_path(@shop), class: "btn secondary" %>
