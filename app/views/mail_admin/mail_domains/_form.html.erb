<%= form_with model: mail_domain, url: url, local: true, class: "form" do |f| %>
  <label>サイト名(管理画面での表示名)</label>
  <%= f.text_field :name, placeholder: "例: サイト本体" %>

  <label>ドメイン(@より後ろの部分)</label>
  <%= f.text_field :domain, placeholder: "例: fuzoku-zero.com" %>

  <label>メールサーバーのホスト名(任意。空欄ならドメインをそのまま使用)</label>
  <%= f.text_field :mail_server_host, placeholder: "例: mail.fuzoku-zero.com" %>

  <label>メモ(任意)</label>
  <%= f.text_area :note, placeholder: "例: 一般ユーザー向けのポータルサイト。問い合わせ用アドレスを置く。" %>

  <%= f.submit submit_label, class: "btn" %>
<% end %>
