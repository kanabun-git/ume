<% content_for :title, "クーポン一覧 | FuzokuZero" %>
<% content_for :meta_description, "お得なクーポンを実施中の風俗店を、エリア・ジャンルから絞り込んで探せます。" %>

<h1>クーポン一覧</h1>

<form class="form" method="get">
  <label>エリア</label>
  <select name="area_id">
    <option value="">すべて</option>
    <% @areas.each do |area| %>
      <option value="<%= area.id %>" <%= "selected" if params[:area_id].to_s == area.id.to_s %>><%= area.name %></option>
    <% end %>
  </select>
  <label>ジャンル</label>
  <select name="genre_id">
    <option value="">すべて</option>
    <% @genres.each do |genre| %>
      <option value="<%= genre.id %>" <%= "selected" if params[:genre_id].to_s == genre.id.to_s %>><%= genre.name %></option>
    <% end %>
  </select>
  <button type="submit" class="btn">絞り込む</button>
</form>

<% if @shops.any? %>
  <div class="shop-listing">
    <% @shops.each do |shop| %>
      <%= render "shops/shop_card", shop: shop %>
    <% end %>
  </div>
<% else %>
  <p class="region-note">現在クーポンを実施中の店舗はありません。</p>
<% end %>

<%= paginate @shops %>
